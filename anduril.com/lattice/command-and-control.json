3dd19115","_type":"block","children":[{"_key":"e8e37270573e","_type":"span","marks":[],"text":"Lattice for C2 integrates legacy and next-generations sensors, effectors, networks, and mission systems in a bidirectional manner with the "},{"_key":"5675f7c48ebf","_type":"span","marks":["0f8efa75fa87"],"text":"Lattice SDK"},{"_key":"88f6fe0b99e6","_type":"span","marks":[],"text":" to provide an an intelligent, comprehensive, and capable common operating picture in a single pane of glass."}],"markDefs":[{"_key":"0f8efa75fa87","_type":"internalLink","reference":{"_id":"1bd71a03-ce59-4609-81fe-426b2d9770f0","_type":"page","language":null,"parent":{"_id":"9b2a6f22-bf61-4544-a460-6584975cb7d9","parent":null,"slug":{"_type":"slug","current":"lattice"}},"slug":{"_type":"slug","current":"lattice-sdk"},"title":"Lattice SDK"},"targetBlank":false}],"style":"normal"}],"headline":"The Best of Today and Tomorrow"},{"_key":"56ca1782dce6","_type":"latticeMissionSliceBlock","description":[{"_key":"fbde64bc9a76","_type":"block","children":[{"_key":"4c3738a2b5e9","_type":"span","marks":[],"text":"Lattice for C2 leverages frontier AI technologies that enable natural operator interactions and decision aides to make rapid, confident, and effective decisions at machine speed. "}],"markDefs":[],"style":"normal"}],"headline":"AI Applied to the Fight"}],"media":[{"_key":"fc00cdcd9ef7","_type":"videoWithMeta","alt":"Lattice for Command and Control battle management platform enabling a single operator to supervise hundreds of autonomous systems simultaneously","asset":{"_id":"file-0245fce432420233ec5f09868ed2fe385fecbd62-mp4","_type":"sanity.fileAsset","mimeType":"video/mp4","duration":9.592917,"width":1690,"height":1278,"optimized":[{"_key":"b094c0e36299","_type":"videoWithMeta","asset":{"_id":"file-0fe09e23cb2508a3c1ef2314a30e9d147fbd6013-mp4","_type":"sanity.fileAsset","mimeType":"video/mp4","duration":9.592917,"width":1690,"height":1278,"thumbnail":{"_type":"image","asset":{"_ref":"image-2c650