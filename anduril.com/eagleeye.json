a805197","_type":"featureSliceBlock","description":[{"_key":"ac79cfed704e","_type":"block","children":[{"_key":"163b72181d44","_type":"span","marks":[],"text":"EagleEye can be configured and optimized for unique mission requirements with modular form factors, extensible add-on sensors, and a library of software plug-ins and integrations."}],"markDefs":[],"style":"normal"}],"headline":"Modularity for Any Mission"},{"_key":"89d8cb737209","_type":"featureSliceBlock","description":[{"_key":"048cf3fcaf8c","_type":"block","children":[{"_key":"f72c094e7d27","_type":"span","marks":[],"text":"EagleEye connects every warfighter to a digital arsenal of effects, sensors, tools, and comms through an open application system and mission command architecture."}],"markDefs":[],"style":"normal"}],"headline":"Connected by Design"}]},{"_key":"3e6100666d6d","_type":"twoColumnRichText","arsenalPadding":false,"backgroundColor":{"_createdAt":"2025-03-28T19:58:16Z","_id":"93236b56-c0b1-425a-b437-fe506a403f5e","_rev":"AvL2O0NKDscm5FGHyg7i2R","_system":{"base":{"id":"93236b56-c0b1-425a-b437-fe506a403f5e","rev":"Rmu8w9WmfRS5MFvcURmmiB"}},"_type":"color","_updatedAt":"2025-10-23T21:43:59Z","contrastColor":"#010101","hex":"#F1F0EA","metadata":null,"name":"Sand"},"column1":[{"_key":"9f0d8548ecf1","_type":"block","children":[{"_key":"ac61b1af5ef9","_type":"span","marks":[],"text":"We are partnering with commercial leaders, such as Meta, Oakley Standard Issue, Qualcomm, and Gentex, who have invested billions in augmented reality, combat eyewear, small form factor compute, environmental sensing, and ballistic protection systems to incorporate proven technology into warfighter-worn platforms today. This approach lowers cost, accelerates development, and ensures a path for continuous innovation."}],"markDefs":[],"style":"h7"}],"column2":[{"_key":"1250da6c9297","_type":"videoWithMeta","alt":"EagleEye warfighter augment system showcasing commercial partnerships with Meta, Oakley, Qualcomm, and Gentex fo