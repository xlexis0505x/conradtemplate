base":{"id":"93236b56-c0b1-425a-b437-fe506a403f5e","rev":"Rmu8w9WmfRS5MFvcURmmiB"}},"_type":"color","_updatedAt":"2025-10-23T21:43:59Z","contrastColor":"#010101","hex":"#F1F0EA","metadata":null,"name":"Sand"},"text":"AUTONOMY</br>FOR</br>EVERY MISSION","width":"100"},{"_key":"4db0ce95c62baad4f8d8859c373d6fea","_type":"spacerSlice","backgroundColor":{"_createdAt":"2025-03-28T19:58:16Z","_id":"93236b56-c0b1-425a-b437-fe506a403f5e","_rev":"AvL2O0NKDscm5FGHyg7i2R","_system":{"base":{"id":"93236b56-c0b1-425a-b437-fe506a403f5e","rev":"Rmu8w9WmfRS5MFvcURmmiB"}},"_type":"color","_updatedAt":"2025-10-23T21:43:59Z","contrastColor":"#010101","hex":"#F1F0EA","metadata":null,"name":"Sand"},"horizontalRule":false,"spacerHeight":"xxl"},{"_key":"88aab402ad97","_type":"featureSlice","backgroundColor":{"_createdAt":"2025-03-28T19:58:16Z","_id":"93236b56-c0b1-425a-b437-fe506a403f5e","_rev":"AvL2O0NKDscm5FGHyg7i2R","_system":{"base":{"id":"93236b56-c0b1-425a-b437-fe506a403f5e","rev":"Rmu8w9WmfRS5MFvcURmmiB"}},"_type":"color","_updatedAt":"2025-10-23T21:43:59Z","contrastColor":"#010101","hex":"#F1F0EA","metadata":null,"name":"Sand"},"features":[{"_key":"4bf31998004d","_type":"featureSliceBlock","description":[{"_key":"8beb860a1600","_type":"block","children":[{"_key":"13c40cbd226c","_type":"span","marks":[],"text":"Today’s conflicts demand software-defined military technology that can be produced at hyper-scale & updated at speed. Unlike traditional defense contractors who focus exclusively on hardware, Anduril’s core product is Lattice: an autonomous sensemaking platform that connects and powers thousands of systems supporting real-world operations."}],"markDefs":[],"style":"normal"}],"headline":"Our Technology","subheadline":"Solutions for the software-defined conflicts of today."},{"_key":"f19fcc1e5860","_type":"featureSliceBlock","description":[{"_key":"eab7387860b5","_type":"block","children":[{"_key":"66ed04b85208","_type":"span","marks":[],"text":"Anduril is a defense products company. Unlike most defense companies, we don’t wait for our customers to tell us what they need. We identify problems, privately fund our R&D and sell finished products off the shelf. Ideas are turned into deployed capabilities in months, not years, saving the government and taxpayers money along the way."}],"markDefs":[],"style":"normal"}],"headline":"Our Business","subheadline":"Cutting-edge technology built at speed."},{"_key":"ba6dcf23376d","_type":"featureSliceBlock","description":[{"_key":"a639b2f407bb","_type":"block","children":[{"_key":"252c03274d8c","_type":"span","marks":[],"text":"Our team brings together the smartest Silicon Valley engineers with veterans who have been on the front lines and have first-hand knowledge of the mission. Anduril engineers are experts in AI, robotics, advanced sensors, secure networking, aerospace, virtual reality technology, aircraft modeling and simulation. Military veterans are more than 12% of our team and use their defense experience to ensure our products meet the needs of the warfighter. "}],"markDefs":[],"style":"normal"}],"headline":"Our Team","subheadline":"The brightest minds in modern defense."}]},{"_key":"e367c75b14e0","_type":"mediaLinkSlice","cards":[{"_key":"e7de5e615121","_type":"mediaLinkCard","color":{"_createdAt":"2025-03-28T19:57:45Z","_id":"312278d0-9291-4102-932f-2fbe38d107f5","_rev":"x8r7rwnZNJLuzU8uziaQjt","_system":{"base":{"id":"312278d0-9291-4102-932f-2fbe38d107f5","rev":"3h6Aq9HwJKloB0447GtDIQ"}},"_type":"color","_updatedAt":"2025-06-18T01:03:01Z","contrastColor":"#FFFFFF","hex":"#505544","metadata":null,"name":"Green"},"cta":[{"_key":"281b99905d50","_type":"internalLink","reference":{"_id":"80da306c-8db6-459b-a6ab-7886f484aee7","_type":"page","language":null,"parent":null,"slug":{"_type":"slug","current":"rebooting-the-arsenal"},"title":"Rebooting the Arsenal"},"targetBlank":false,"text":"Read More"}],"image":{"_type":"imageWithMeta","alt":"Rebooting the Arsenal — Anduril's vision for rebuilding 