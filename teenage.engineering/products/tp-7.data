ed = !START_WITH_SOUND; // control sound\n      videoEl.playsInline = true;\n      videoEl.autoplay = true;\n\n      const p = videoEl.play();\n      if (p && typeof p.catch === \"function\") p.catch(() => {});\n    }\n  };\n}",{"_143":8142,"_15":2147,"_413":2532,"_1495":8143,"_1551":8144,"_2149":82},[8107,8108],{"_87":8125,"_88":8126,"_90":137},{"_87":8109,"_88":8110,"_90":137},{"_143":8122,"_183":8123,"_413":8124,"_2558":82},[8111],{"_87":8112,"_90":2532},{"_2533":8113,"_2535":33,"_2536":33,"_2532":8114,"_2538":33,"_2539":82},"69957ef84319ab1763e8c9b9",{"_413":8115,"_2541":8116,"_19":8117,"_30":2544,"_2545":8118,"_2547":82,"_32":33,"_2548":33,"_2549":8119},"69957ef8bffc1e1763329234","2026-02-18T08:57:28.295Z",[],[8121,2555,2554],{"_413":8113,"_2551":8120},"https://assets.teenage.engineering/_videos/69957ef84319ab1763e8c9b9/thumb.jpg","desktop",{"_188":188,"_146":2561},{"_188":188,"_146":2050},"full-video",{"_143":8138,"_183":8139,"_413":8140,"_1995":82},[8127],{"_87":8128,"_90":2532},{"_2533":8129,"_2535":82,"_2536":82,"_2532":8130,"_2538":82,"_2539":33},"698f4141579e8b3a1d0c45b5",{"_413":8131,"_2541":8132,"_19":8133,"_30":8134,"_2545":8135,"_2547":82,"_32":33,"_2548":33,"_2549":8136},"698f4141383d823a1d705246","2026-02-13T15:20:33.740Z",[],"tape-web-2 (2160p)",[8],{"_413":8129,"_2551":8137},"https://assets.teenage.engineering/_videos/698f4141579e8b3a1d0c45b5/thumb.jpg",{"_188":188,"_146":8141},{"_188":188,"_146":2050},"bg-loop",553,{"_188":188,"_146":2561},{"_188":188,"_146":2050},{"_188":188,"_146":2050},{"_143":8182,"_502":8183,"_413":21},[8147,8148,8149,8150],{"_87":8180,"_90":137},{"_87":8177,"_90":137},{"_87":8163,"_88":8164,"_90":137},{"_87":8151,"_88":8152,"_90":137},{"_143":8157,"_183":8158,"_15":2599,"_2558":82,"_185":8159},[8153],{"_87":8154,"_90":137},{"_143":8155,"_183":8156,"_413":2590,"_2558":82,"_2521":2592},{"_146":1498},{"_188":188,"_146":3206},{"_146":1498},{"_188":188,"_146":3206},{"_188":188,"_146":8160},{"_181":8161,"_190":8162},618,104,{"_14