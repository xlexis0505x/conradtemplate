   // start native video\n    const videoEl = getVideoEl();\n    if (videoEl && videoEl.tagName === \"VIDEO\") {\n      videoEl.muted = !START_WITH_SOUND; // control sound\n      videoEl.playsInline = true;\n      videoEl.autoplay = true;\n\n      const p = videoEl.play();\n      if (p && typeof p.catch === \"function\") p.catch(() => {});\n    }\n  };\n}",{"_181":159},{"_143":2578,"_15":2147,"_413":2532,"_1495":2579,"_1551":2580,"_2149":82},[2526,2527],{"_87":2562,"_88":2563,"_90":137},{"_87":2528,"_88":2529,"_90":137},{"_143":2556,"_15":2147,"_413":2557,"_2558":82,"_1495":2559,"_1551":2560,"_2149":82},[2530],{"_87":2531,"_90":2532},{"_2533":2534,"_2535":33,"_2536":33,"_2532":2537,"_2538":33,"_2539":82},"video","src","699583d9c28cab18224e06a8","loop","mute",{"_413":2540,"_2541":2542,"_19":2543,"_30":2544,"_2545":2546,"_2547":82,"_32":33,"_2548":33,"_2549":2550},"autoplay","controls","699583d922a7ce1822ff70c1","date","2026-02-18T09:18:17.968Z",[],"teenage engineering - field system™","tags",[2553,2554,2555],"ready","processing","current_revision",{"_413":2534,"_2551":2552},"thumbnail_url","https://assets.teenage.engineering/_videos/699583d9c28cab18224e06a8/thumb.jpg","mobile","full video","field system",{"_188":188,"_146":2561},"full-video-mobile","rp",{"_188":188,"_146":2050},{"_188":188,"_146":2050},552,{"_143":2574,"_15":2147,"_413":2575,"_1995":82,"_1495":2576,"_1551":2577,"_2149":82},[2564],{"_87":2565,"_90":2532},{"_2533":2566,"_2535":82,"_2536":82,"_2532":2567,"_2538":82,"_2539":33},"699583828b442e18222183ac",{"_413":2568,"_2541":2569,"_19":2570,"_30":2544,"_2545":2571,"_2547":82,"_32":33,"_2548":33,"_2549":2572},"6995838270f5781822acd695","2026-02-18T09:16:50.267Z",[],[2553,2535,2555],{"_413":2566,"_2551":2573},"https://assets.teenage.engineering/_videos/699583828b442e18222183ac/thumb.jpg",{"_188":188,"_146":2561},"bg-loop-mobile",{"_188":188,"_146":2050},{"_188":188,"_146":2050},{"_188":188,"_146":2561},{"_188":188,"_146":2050},{"_188":188,"_146":2050},{"_1