if (target === this.pauseBtn) {\n        this.pauseVideo();\n      }\n    }\n\n    updateUI() {\n      if (!this.videoPlayer.paused) {\n        this.playBtn.style.display = \"none\";\n        this.pauseBtn.style.display = \"block\";\n      } else {\n        this.playBtn.style.display = \"block\";\n        this.pauseBtn.style.display = \"none\";\n      }\n    }\n\n    playVideo() {\n      if (\n        currentlyPlayingVideo != null &&\n        currentlyPlayingVideo !== this.videoPlayer\n      ) {\n        currentlyPlayingVideo.pause();\n      }\n      if (this.videoPlayer != null) {\n        this.thumbnail.style.display = \"none\";\n        this.videoPlayer.play();\n        currentlyPlayingVideo = this.videoPlayer;\n      }\n      this.updateUI();\n    }\n\n    pauseVideo() {\n      if (currentlyPlayingVideo === this.videoPlayer) {\n        this.videoPlayer.pause();\n        currentlyPlayingVideo = null;\n      } else {\n        this.videoPlayer.pause();\n      }\n      this.updateUI();\n    }\n\n    onVideoPause() {\n      this.updateUI();\n    }\n\n    onVideoPlay() {\n      this.updateUI();\n    }\n  }\n\n  function initializeVideo(container, maxRetryAttempts, currentAttempt = 1) {\n    const videoPlayer = container.querySelector(\"#video-player\");\n    if (!videoPlayer) {\n      if (currentAttempt < maxRetryAttempts) {\n        setTimeout(() => {\n          initializeVideo(container, maxRetryAttempts, currentAttempt + 1);\n        }, 1000);\n      }\n      return;\n    }\n\n    new VideoPlayer(container);\n  }\n\n  videoContainers.forEach((container) => {\n    initializeVideo(container, 5);\n  });\n}",{"_154":3132,"_727":3133,"_27":21},{"_245":1691,"_158":2698},{"_21":3134},{"_29":3135,"_30":21,"_33":34,"_35":3136,"_38":3137},"652d23740b4176bcaf401fca","652d23740b4176bcaf401fc8",{"_40":3138,"_42":3139,"_44":3140,"_46":3141,"_48":3142,"_50":3143,"_52":3144,"_54":3145},{"_62":3152,"_56":88,"_58":88,"_60":89},{"_62":3151,"_56":84,"_58":84,"_60":86},{"_62":3150,"_56