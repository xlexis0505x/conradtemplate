age;\n          break;\n        }\n      }\n\n      images.forEach((image) => {\n        if (image === targetImage) {\n          image.classList.add(\"active\");\n        } else {\n          image.classList.remove(\"active\");\n        }\n      });\n      selectors.forEach((sel) => {\n        if (sel === selector) {\n          sel.classList.add(\"active\");\n        } else {\n          sel.classList.remove(\"active\");\n        }\n      });\n    });\n  });\n}",{"_177":1701},"slider-mobile","if (!$.init) {\n  // Updates arrow svg on mobile for sliders with added id \"slider-mobile\"\n\n  $.init = true;\n  const mobileSliderCss = `\n    #slider-mobile .arw-wrapper {\n      width: 1.875rem !important;\n    }\n\n    #slider-mobile .arw-left,\n    #slider-mobile .arw-right {\n      scale: 1;\n    }\n    #slider-mobile .arw-left {\n      background-image: url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2211%22%20height%3D%2210%22%20viewBox%3D%220%200%2011%2010%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M5.39567%209.8313L5.90492%209.32204L1.9432%205.36042L10.5645%205.36043L10.5645%204.63974L1.9432%204.63974L5.90492%200.677514L5.39567%200.16836L0.564454%205.00008L5.39567%209.8313Z%22%20fill%3D%22%230F0E12%22%2F%3E%3C%2Fsvg%3E') !important;\n    }\n    #slider-mobile .arw-right {\n      background-image: url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2211%22%20height%3D%2210%22%20viewBox%3D%220%200%2011%2010%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M5.73324%200.168457L5.22398%200.677712L9.1857%204.63933H0.564453V5.36001H9.1857L5.22398%209.32224L5.73324%209.8314L10.5645%204.99967L5.73324%200.168457Z%22%20fill%3D%22%230F0E12%22%2F%3E%3C%2Fsvg%3E') !important;\n    }\n  `;\n\n  const newStyle = document.createElement(\"style\");\n  newStyle.innerHTML = mobileSliderCss;\n  const parentNode = $.elm.parentNode;\n  parentNode.insertBefore(newStyle, $.elm);\n}",{"_476":5421,"_175":146},[53