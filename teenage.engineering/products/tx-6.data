\n    e.preventDefault();\n    e.stopPropagation();\n\n    const bgLoop = document.getElementById(BG_LOOP_ID);\n    if (!bgLoop) return;\n\n    // remove loop from DOM\n    const parent = bgLoop.parentElement;\n    if (parent) {\n      setTimeout(() => parent.removeChild(bgLoop), 500);\n    }\n\n    // show full video + hide play button\n    if (fullVideo) fullVideo.style.visibility = \"visible\";\n    if (playBtn) {\n      playBtn.style.visibility = \"hidden\";\n      playBtn.style.zIndex = \"10000\";\n    }\n\n    // start native video\n    const videoEl = getVideoEl();\n    if (videoEl && videoEl.tagName === \"VIDEO\") {\n      videoEl.muted = !START_WITH_SOUND; // control sound\n      videoEl.playsInline = true;\n      videoEl.autoplay = true;\n\n      const p = videoEl.play();\n      if (p && typeof p.catch === \"function\") p.catch(() => {});\n    }\n  };\n}",{"_215":12246,"_15":4608,"_476":5477,"_1559":12247,"_1566":12248,"_4610":82},[12212,12213],{"_87":12229,"_88":12230,"_90":131},{"_87":12214,"_88":12215,"_90":131},{"_215":12226,"_170":12227,"_476":12228,"_4485":82},[12216],{"_87":12217,"_90":5477},{"_5478":12218,"_5480":33,"_5481":33,"_5477":12219,"_5483":33,"_5484":82},"6995b8a265322c472dae1d28",{"_476":12220,"_5486":12221,"_19":12222,"_30":5489,"_5490":12223,"_5492":82,"_32":33,"_5493":33,"_5494":12224},"6995b8a25b3605472dfc9db1","2026-02-18T13:03:30.610Z",[],[],{"_476":12218,"_5496":12225},"https://assets.teenage.engineering/_videos/6995b8a265322c472dae1d28/thumb.jpg",{"_176":176,"_177":5504},{"_176":176,"_177":1793},"full-video",{"_215":12242,"_170":12243,"_476":12244,"_5151":82},[12231],{"_87":12232,"_90":5477},{"_5478":12233,"_5480":82,"_5481":82,"_5477":12234,"_5483":82,"_5484":33},"6995a6b6bacfed38935f4928",{"_476":12235,"_5486":12236,"_19":12237,"_30":5489,"_5490":12238,"_5492":82,"_32":33,"_5493":33,"_5494":12239},"6995a6b6cf5c2e3893e9e632","2026-02-18T11:47:02.721Z",[],[12241,5480,8],{"_476":12233,"_5496":12240},"https://assets.teenage.engineer