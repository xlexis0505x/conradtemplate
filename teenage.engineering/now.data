"_150":8147},"listen to some samples from the sound pack: ",{"_190":190,"_139":8150},{"_190":92,"_139":3234},265,{"_139":209},{"_190":92,"_139":407},{"_176":8154,"_178":8155,"_464":8156,"_395":232},{"_139":396},{"_139":209},{"_190":92,"_139":232},{"_178":8190,"_181":7026,"_464":8191,"_7106":32},[8159,8160],{"_91":8177,"_92":8178,"_94":113},{"_91":8161,"_92":8162,"_94":113},{"_178":8176,"_181":463},[8163],{"_91":8164,"_94":119},{"_92":8165},[8166,8167],{"_92":8170,"_128":129,"_130":420,"_132":8171},{"_92":8168,"_128":129,"_130":420},[8169],{"_128":144},[8174],{"_136":8172,"_94":11,"_139":8173},{"_141":142},"downloads/op-xy/sound-packs",{"_128":150,"_150":8175},"sound library",{"_190":190,"_139":781},{"_176":8187,"_178":8188,"_132":8189,"_395":232},[8179],{"_91":8180,"_94":6902},{"_20":8181},{"_181":7090,"_26":7090,"_28":6902,"_31":32,"_33":7091,"_525":7091,"_35":8182},{"_43":8183,"_6913":8184,"_47":8185,"_6916":8186},{"_542":7099,"_49":560,"_51":560,"_53":562},{"_542":7098,"_49":-5,"_51":-5,"_53":6921},{"_49":7019,"_51":7019,"_53":6919},{"_542":7097,"_49":-5,"_51":-5,"_53":6918},{"_190":190,"_139":1587},{"_190":190,"_139":1587},{"_94":11,"_139":8173},{"_139":209},{"_190":92,"_139":8103},{"_178":8208,"_181":463,"_464":8209},[8194],{"_91":8195,"_94":119},{"_92":8196},[8197],{"_92":8198,"_128":129,"_130":420},[8199,8200,8201,8202,8203,8204,8205],{"_128":150,"_150":8207},{"_128":144},{"_128":144},{"_128":150,"_150":8206},{"_128":144},{"_128":144},{"_128":144},"download the sound library here:","with a career spanning songwriting, production, and sound design, douglas carr has spent decades working behind the boards. during his time at swemix and cheiron (two studios that played a pivotal role in shaping the '90s pop sound) he wrote and produced iconic hits for artists like ace of base, leila k, dr. alban, and meja. driven since childhood by a passion for melody, experimentation, and technology, he has now developed a dedicated sound library for the OP–XY, especially tail