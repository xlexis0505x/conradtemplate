"_51":560,"_53":562},{"_542":6965,"_49":556,"_51":556,"_53":558},{"_542":6964,"_49":552,"_51":552,"_53":554},{"_542":6963,"_49":548,"_51":548,"_53":550},{"_49":548,"_51":548,"_53":54},{"_176":7823,"_178":7824,"_464":7825,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[7828,7829,7830],{"_91":7848,"_94":113},{"_91":7834,"_92":7835,"_94":113},{"_91":7831,"_94":113},{"_176":7832,"_178":7833,"_395":396},{"_139":407},{"_139":189},{"_178":7846,"_181":463,"_464":7847,"_185":232},[7836],{"_91":7837,"_94":119},{"_92":7838},[7839,7840],{"_92":7843,"_128":129,"_130":420},{"_92":7841,"_128":129,"_130":441},[7842],{"_128":144},[7844],{"_128":150,"_150":7845},"the way the OP–XY sounds and behaves is incredibly inspiring. i noticed right away that it forces you to truly listen, stepping away from the mouse and the big computer screen is always refreshing. i hope this library inspires your own journey with sound and helps you create some great songs!”",{"_139":209},{"_190":190,"_139":466},{"_176":7849,"_178":7850,"_182":7851,"_464":7852,"_471":142},{"_190":191,"_139":209},{"_139":232},{"_190":191,"_139":7853},{"_190":190,"_139":472},32,{"_181":20},[7856,7857,7858,7859],{"_91":7918,"_94":113},{"_91":7881,"_94":113},{"_91":7862,"_92":7863,"_94":113},{"_91":7860,"_94":113},{"_176":7861,"_395":396},{"_139":396},{"_181":503},[7864,7865],{"_91":7877,"_94":113},{"_91":7866,"_92":7867,"_94":113},{"_178":7875,"_464":7876,"_185":232},[7868],{"_91":7869,"_94":119},{"_92":7870},[7871],{"_92":7872,"_128":129,"_130":493,"_134":494},[7873,7874],{"_128":144},{"_128":144},{"_139":209},{"_139":189},{"_176":7878,"_178":7879,"_464":7880,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":7882,"_178":7883,"_508":7884,"_510":7885,"_181":512,"_182":7886,"_464":7887},{"_190":190,"_139":4952},{"_139":209},{"_2685":7888,"_518":7889,"_520":7890,"_20":7891},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_190":5663,"_139":188},{"_190":5663,"_139":2607},{"_190":5663,"_139":1910},{"_181":7892,"_26":7892,"_5630":7893,"_28":20,"_29":7894,"_5633":7895,"_31":32,"_33":7896,"_525":7896,"_5636":32,"_35":7897,"_6907":7898},"6ad1cbcb3feaf512fd58ced6","2026-10-16T07:01:31.442Z","DSC09095.jpg",[],"6ad1cbcbb4905e12fdbe15ec",{"_37":7901,"_39":7902,"_41":7903,"_43":7904,"_45":7905,"_532":7906,"_534":7907,"_47":7908},{"_5630":7899,"_6910":7900},"2026-10-16T07:01:31.44229+00:00","miranda@teenage.engineering",{"_542":7917,"_49":572,"_51":560,"_53":574},{"_542":7916,"_49":568,"_51":5661,"_53":570},{"_542":7915,"_49":564,"_51":5659,"_53":566},{"_542":7914,"_49":560,"_51":5657,"_53":562},{"_542":7913,"_49":556,"_51":5655,"_53":558},{"_542":7912,"_49":552,"_51":5653,"_53":554},{"_542":7911,"_49":548,"_51":544,"_53":550},{"_49":7909,"_51":7910,"_53":541},4128,5160,4199592,927010,122748,2884,17774,5834,2394,{"_176":7919,"_178":7920,"_464":7921,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[7924,7925,7926],{"_91":7944,"_94":113},{"_91":7930,"_92":7931,"_94":113},{"_91":7927,"_94":113},{"_176":7928,"_178":7929,"_395":396},{"_139":407},{"_139":189},{"_178":7942,"_181":463,"_464":7943,"_185":232},[7932],{"_91":7933,"_94":119},{"_92":7934},[7935],{"_92":7936,"_128":129,"_130":420},[7937,7938,7939,7940],{"_128":150,"_150":7941},{"_128":144},{"_128":144},{"_128":144},"i approached the sound design with a sense of curiosity, using a few studio tricks to tailor everything specifically for the OP–XY. to me, one of the best aspects of working with samples is keeping an open mind about what a sound can become. It rarely matters if the source is a saxophone or a pot from the kitchen. everything in the signal path colors the result: the microphone, preamps, EQs, and converters. bouncing sounds through an old sampler, pitching them up, and then running them into another 8-, 12-, or 13-bit converter can yield incredible textures. finding ways to make noise beyond an instrument's intended purpose is always fun, much like cranking the gain on a guitar amp. but even in contrast to that, feeding a pure, clean signal into the OP–XY is just as rewarding.",{"_139":209},{"_190":190,"_139":466},{"_176":7945,"_178":7946,"_182":7947,"_464":7948,"_471":142},{"_190":191,"_139":7950},{"_139":232},{"_190":191,"_139":7949},{"_190":190,"_139":472},82,17,{"_181":20},[7953,7954,7955,7956],{"_91":8009,"_94":113},{"_91":7977,"_94":113},{"_91":7959,"_92":7960,"_94":113},{"_91":7957,"_94":113},{"_176":7958,"_395":396},{"_139":396},{"_181":503},[7961,7962],{"_91":7973,"_94":113},{"_91":7963,"_92":7964,"_94":113},{"_178":7971,"_464":7972,"_185":232},[7965],{"_91":7966,"_94":119},{"_92":7967},[7968],{"_92":7969,"_128":129,"_130":493,"_134":494},[7970],{"_128":144},{"_139":209},{"_139":189},{"_176":7974,"_178":7975,"_464":7976,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":7978,"_178":7979,"_508":7980,"_510":7981,"_181":512,"_182":7982,"_464":7983},{"_190":190,"_139":4952},{"_139":209},{"_518":7984,"_20":7985},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_190":5663,"_139":5902},{"_181":7986,"_26":7986,"_5630":7987,"_28":20,"_29":7988,"_5633":7989,"_31":32,"_33":7990,"_525":7990,"_5636":32,"_35":7991,"_6907":7992},"6ad1c8c8aeb0610f8d69231e","2026-10-16T06:48:40.301Z","DSC09083.jpg",[],"6ad1c8c84246440f8da74143",{"_37":7994,"_39":7995,"_41":7996,"_43":7997,"_45":7998,"_532":7999,"_534":8000,"_47":8001},{"_5630":7993,"_6910":6911},"2026-10-16T06:48:40.301322+00:00",{"_542":8008,"_49":572,"_51":560,"_53":574},{"_542":8007,"_49":568,"_51":5661,"_53":570},{"_542":8006,"_49":564,"_51":5659,"_53":566},{"_542":8005,"_49":560,"_51":5657,"_53":562},{"_542":8004,"_49":556,"_51":5655,"_53":558},{"_542":8003,"_49":552,"_51":5653,"_53":554},{"_542":8002,"_49":548,"_51":544,"_53":550},{"_49":7909,"_51":7910,"_53":541},4617648,1147830,195328,6174,38866,12924,4804,{"_176":8010,"_178":8011,"_464":8012,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[8015,8016,8017],{"_91":8038,"_94":113},{"_91":8021,"_92":8022,"_94":113},{"_91":8018,"_94":113},{"_176":8019,"_178":8020,"_395":396},{"_139":407},{"_139":189},{"_178":8036,"_181":463,"_464":8037,"_185":232},[8023],{"_91":8024,"_94":119},{"_92":8025},[8026],{"_92":8027,"_128":129,"_130":420},[8028,8029,8030,8031,8032,8033],{"_128":150,"_150":8035},{"_128":144},{"_128":144},{"_128":150,"_150":8034},{"_128":144},{"_128":144},"“every instrument has its own unique character and texture, and the OP–XY is no exception. ever since i was young, i’ve been fascinated by sounds, records, and the emotions they carry. having spent many years in the studio writing, recording, producing, and mixing, i’ve come across a lot of gear. the OP–XY has inspired me to reflect on classic techniques and revisit traditional workflows. my goal with this soundpack was to broaden the instrument's horizons and to bring something new to the OP–XY that it doesn't already have. i began dissecting vintage samplers from the 80s and 90s, focusing on those imperfect machines that produce such incredible, unique textures, something many contemporary tools fail to replicate.","here is the sound library described in douglas own words:",{"_139":209},{"_190":190,"_139":466},{"_176":8039,"_178":8040,"_182":8041,"_464":8042,"_471":142},{"_190":191,"_139":8043},{"_139":232},{"_190":191,"_139":5144},{"_190":190,"_139":472},18,{"_181":20},[8046,8047,8048,8049],{"_91":8104,"_94":113},{"_91":8070,"_94":113},{"_91":8052,"_92":8053,"_94":113},{"_91":8050,"_94":113},{"_176":8051,"_395":396},{"_139":396},{"_181":503},[8054,8055],{"_91":8066,"_94":113},{"_91":8056,"_92":8057,"_94":113},{"_178":8064,"_464":8065,"_185":232},[8058],{"_91":8059,"_94":119},{"_92":8060},[8061],{"_92":8062,"_128":129,"_130":493,"_134":494},[8063],{"_128":144},{"_139":209},{"_139":189},{"_176":8067,"_178":8068,"_464":8069,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":8071,"_178":8072,"_508":8073,"_510":8074,"_181":512,"_182":8075,"_464":8076},{"_190":190,"_139":4952},{"_139":209},{"_2685":8077,"_518":80