:81},{"_176":5513,"_178":5514,"_14":2483,"_508":5515,"_510":5516,"_181":512,"_182":5517,"_464":5518,"_132":5519},{"_190":190,"_139":2512},{"_139":209},{"_518":5521,"_520":5522,"_20":5523},{"_139":517},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_136":5520,"_94":11,"_139":1586},{"_148":32},{"_139":188},{"_139":2511},{"_181":2493,"_26":2493,"_28":20,"_31":32,"_33":2494,"_525":2494,"_35":5524},{"_37":5525,"_39":5526,"_41":5527,"_43":5528,"_45":5529,"_532":5530,"_534":5531,"_47":5532},{"_542":2510,"_49":572,"_51":572,"_53":574},{"_542":2509,"_49":568,"_51":568,"_53":570},{"_542":2508,"_49":564,"_51":564,"_53":566},{"_542":2507,"_49":560,"_51":560,"_53":562},{"_542":2506,"_49":556,"_51":556,"_53":558},{"_542":2505,"_49":552,"_51":552,"_53":554},{"_542":2504,"_49":548,"_51":548,"_53":550},{"_49":548,"_51":548,"_53":54},{"_176":5534,"_178":5535,"_464":5536,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[5539,5540,5541],{"_91":5585,"_94":113},{"_91":5545,"_92":5546,"_94":113},{"_91":5542,"_94":113},{"_176":5543,"_178":5544,"_395":396},{"_139":407},{"_139":189},{"_178":5583,"_181":463,"_464":5584,"_185":232},[5547],{"_91":5548,"_94":119},{"_92":5549},[5550,5551],{"_92":5579,"_128":129,"_130":441},{"_92":5552,"_128":129,"_130":420},[5553,5554,5555,5556,5557,5558,5559,5560,5561,5562,5563],{"_128":144},{"_128":150,"_150":5578},{"_92":5572,"_128":132,"_132":5573},{"_128":150,"_150":5571},{"_92":5566,"_128":132,"_132":5567},{"_128":150,"_150":5565},{"_128":144},{"_128":144},{"_128":150,"_150":5564},{"_128":144},{"_128":144},"step components are more of an interplay with the synthesizer. you choose what kind of tools you want it to use, and then let it randomly decide when to use them. it helps me stay inspired when i’m writing songs.",". i use arpeggio almost like a sound effect, by selecting one note that moves randomly across four octaves with delay and portamento. it gives every melody a new and unique touch.",[5569],{"_94":11,"_139":5568},"guides/op-xy/step-components",{"_128":150,"_150":5570},"step components"," and ",[5577],{"_136":5574,"_94":11,"_139":5575},{"_1507":5576},"guides/op-xy/players","arpeggio",{"_128":150,"_150":5576},"my favorites would probably be ",[5580,5581],{"_128":150,"_150":5582},{"_128":144},"what are your favorite features on the OP–XY?",{"_139":209},{"_190":190,"_139":466},{"_176":5586,"_178":5587,"_182":5588,"_464":5589,"_471":142},{"_190":191,"_139":186},{"_139":232},{"_190":191,"_139":874},{"_190":190,"_139":472},{"_181":20},[5592,5593,5594,5595],{"_91":5664,"_94":113},{"_91":5619,"_94":113},{"_91":5598,"_92":5599,"_94":113},{"_91":5596,"_94":113},{"_176":5597,"_395":396},{"_139":396},{"_181":503},[5600,5601],{"_91":5615,"_94":113},{"_91":5602,"_92":5603,"_94":113},{"_178":5613,"_464":5614,"_185":232},[5604],{"_91":5605,"_94":119},{"_92":5606},[5607],{"_92":5608,"_128":129,"_130":493,"_134":494},[5609,5610,5611],{"_128":144},{"_128":150,"_150":5612},{"_128":144},"photo by fredrik bengtsson",{"_139":209},{"_139":189},{"_176":5616,"_178":5617,"_464":5618,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":5620,"_178":5621,"_508":5622,"_510":5623,"_181":512,"_182":5624,"_464":5625},{"_190":190,"_139":4952},{"_139":209},{"_518":5626,"_520":5627,"_20":5628},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_190":5663,"_139":232},{"_190":5663,"_139":4202},{"_181":5629,"_26":5629,"_5630":5631,"_28":20,"_29":5632,"_5633":5634,"_31":32,"_33":5635,"_525":5635,"_5636":32,"_35":5637},"6aa2a31c8fb0f23493a4d809","date","2026-09-10T12:31:24.142Z","260320_ESTHER_04_102 1_(Fredrik Bengtsson).jpg","tags",[],"6aa2a31caa15a634931b533b","processing",{"_37":5638,"_39":5639,"_41":5640,"_43":5641,"_45":5642,"_532":5643,"_534":5644,"_536":5645,"_47":5646},{"_542":5662,"_49":572,"_51":560,"_53":574},{"_542":5660,"_49":568,"_51":5661,"_53":570},{"_542":5658,"_49":564,"_51":5659,"_53":566},{"_542":5656,"_49":560,"_51":5657,"_53":562},{"_542":5654,"_49":556,"_51":5655,"_53":558},{"_542":5652,"_49":552,"_51":5653,"_53":554},{"_542":5651,"_49":548,"_51":544,"_53":550},{"_542":5649,"_49":544,"_51":5650,"_53":546},{"_49":5647,"_51":5648,"_53":541},6554,8192,4890004,6400,3518840,820184,2560,181596,1280,2638,200,31740,640,6362,320,2134,"p",{"_176":5665,"_178":5666,"_464":5667,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[5670,5671,5672],{"_91":5701,"_94":113},{"_91":5676,"_92":5677,"_94":113},{"_91":5673,"_94":113},{"_176":5674,"_178":5675,"_395":396},{"_139":407},{"_139":189},{"_178":5699,"_181":463,"_464":5700,"_185":232},[5678],{"_91":5679,"_94":119},{"_92":5680},[5681],{"_92":5682,"_128":129,"_130":420},[5683,5684,5685,5686,5687,5688,5689,5690,5691,5692],{"_92":5696,"_128":129,"_130":3379},{"_128":144},{"_128":144},{"_128":150,"_150":5695},{"_128":144},{"_128":144},{"_128":150,"_150":5694},{"_128":144},{"_128":144},{"_128":150,"_150":5693},"i really like working with other people. when you work alone, you have to stand behind everything 100%, and it’s easy to become a little half-hearted. when you work with someone else, you only have to be responsible for half of it, and somehow that makes it easier to give 100%.","the inspiration has been completely different for every song. sometimes i’ve just thought, “f***, i want to make a punk song,” and gone from there. the inspiration can really be anything. i’m also very inspired by people. sometimes all it takes is having a new person in the room and suddenly the result becomes something completely different. a lot of it comes down to the energy in the room when the song is being written.","the oldest song on the album was written in 2019, but it was about a year and a half ago that we really started figuring out what we wanted the album to sound like. it’s been both a very long and very short process. for the most part, i’ve just gone along with it and let it develop naturally. i wrote the album together with vincent pontare, salem al fakir, marcus white, tove burman, joel henriksson, wilma wall and amanda börjesson.",[5697],{"_128":150,"_150":5698},"you’ve released a new album called “fragmentality”, can you tell us a bit about the process and the inspiration behind the songs?",{"_139":209},{"_190":190,"_139":466},{"_176":5702,"_178":5703,"_182":5704,"_464":5705,"_471":142},{"_190":191,"_139":5707},{"_139":232},{"_190":191,"_139":5706},{"_190":190,"_139":472},148,31,{"_181":20},[5710,5711,5712,5713],{"_91":5767,"_94":113},{"_91":5735,"_94":113},{"_91":5716,"_92":5717,"_94":113},{"_91":5714,"_94":113},{"_176":5715,"_395":396},{"_139":396},{"_181":503},[5718,5719],{"_91":5731,"_94":113},{"_91":5720,"_92":5721,"_94":113},{"_178":5729,"_464":5730,"_185":232},[5722],{"_91":5723,"_94":119},{"_92":5724},[5725],{"_92":5726,"_128":129,"_130":493,"_134":494},[5727,5728],{"_128":144},{"_128":150,"_150":5612},{"_139":209},{"_139":189},{"_176":5732,"_178":5733,"_464":5734,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":5736,"_178":5737,"_508":5738,"_510":5739,"_181":512,"_182":5740,"_464":5741},{"_190":190,"_139":4952},{"_139":209},{"_518":5742,"_520":5743,"_20":5744},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_190":5663,"_139":232},{"_139":3614},{"_181":5745,"_26":5745,"_5630":5746,"_28":20,"_29":5747,"_5633":5748,"_31":32,"_33":5749,"_525":5749,"_5636":32,"_35":5750},"6aa2a2bbb7692c3493e12188","2026-09-10T12:29:47.585Z","260320_ESTHER_02_253_(Fredrik Bengtsson).jpg",[],"6aa2a2bb8d0cf63493b13e9b",{"_37":5751,"_39":5752,"_41":5753,"_43":5754,"_45":5755,"_532":5756,"_47":5757},{"_542":5766,"_49":572,"_51":560,"_53":574},{"_542":5765,"_49":568,"_51":5661,"_53":570},{"_542":5764,"_49":564,"_51":5659,"_53":566},{"_542":5763,"_49":560,"_51":5657,"_53":562},{"_542":5761,"_49":556,"_51":5762,"_53":558},{"_542":5759,"_49":552,"_51":5760,"_53":554},{"_49":5758,"_51":540,"_53":541},3202,720420,2558,122220,1279,3318,25236,7038,2782,{"_176":5768,"_178":5769,"_464":5770,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[5773,5774,5775,5776,5777],{"_91":5838,"_94":113},{"_91":5818,"_92":5819,"_94":113},{"_91":5798,"_92":5799,"_94":113},{"_91":5781,"_92":5782,"_94":113},{"_91":5778,"_94":113},{"_176":5779,"_178":5780,"_395":396},{"_139":407},{"_139":189},{"_178":5796,"_181":463,"_464":5797,"_185":232},[5783],{"_91":5784,"_94":119},{"_92":5785},[5786],{"_92":5787,"_128":129,"_130":420},[5788,5789,5790,5791],{"_92":5793,"_128":129,"_130":3379},{"_128":144},{"_128":144},{"_128":150,"_150":5792},"i use a midi vibraphone, which is a genius little thing because you can fold it in half. i connect it to my OP–XY and use the sounds from the OP–XY. i actually like playing the vibraphone more than the sound of the instrument itself, so i love being able to choose what sound it plays. the OP–XY is the brain and the vibraphone is the tool.",[5794],{"_128":150,"_150":5795},"what’s in your live set-up?",{"_139":209},{"_190":190,"_139":466},{"_178":5816,"_181":463,"_464":5817,"_185":232},[5800],{"_91":5801,"_94":119},{"_92":5802},[5803],{"_92":5804,"_128":129,"_130":420},[5805,5806,5807,5808,5809,5810,5811],{"_92":5813,"_128":129,"_130":3379},{"_128":144},{"_128":144},{"_128":150,"_150":5812},{"_128":144},{"_128":144},{"_128":144},"i haven’t really had the space for a vibraphone, so it’s been difficult to include it in my sessions. now i have a new electronic version that i bring with me sometimes, but unfortunately it still doesn’t make it into my creative process as much as i’d like",[5814],{"_128":150,"_150":5815},"how did the vibraphone become your instrument?",{"_139":209},{"_190":190,"_139":466},{"_178":5836,"_181":463,"_464":5837,"_185":232},[5820],{"_91":5821,"_94":119},{"_92":5822},[5823],{"_92":5824,"_128":129,"_130":420},[5825,5826,5827,5828,5829,5830,5831],{"_92":5833,"_128":129,"_130":3379},{"_128":144},{"_128":144},{"_128":150,"_150":5832},{"_128":144},{"_128":144},{"_128":144},"the reason i play and sing with my vibraphone today is simply because jesper asked me to play it at that show in copenhagen. it just stuck with me. before that, i played piano and drums, but i was only kind of okay at both. then i found the vibraphone, basically a piano that you get to hit. it was a pretty good compromise",[5834],{"_128":150,"_150":5835},"why do you play on a vibraphone?",{"_139":209},{"_190":190,"_139":466},{"_176":5839,"_178":5840,"_182":5841,"_464":5842,"_471":142},{"_190":191,"_139":192},{"_139":232},{"_190":191,"_139":5706},{"_190":190,"_139":472},{"_181":20},[5845,5846,5847,5848],{"_91":5903,"_94":113},{"_91":5871,"_94":113},{"_91":5851,"_92":5852,"_94":113},{"_91":5849,"_94":113},{"_176":5850,"_395":396},{"_139":396},{"_181":503},[5853,5854],{"_91":5867,"_94":113},{"_91":5855,"_92":5856,"_94":113},{"_178":5865,"_464":5866,"_185":232},[5857],{"_91":5858,"_94":119},{"_92":5859},[5860],{"_92":5861,"_128":129,"_130":493,"_134":494},[5862,5863,5864],{"_128":144},{"_128":150,"_150":5612},{"_128":144},{"_139":209},{"_139":189},{"_176":5868,"_178":5869,"_464":5870,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":5872,"_178":5873,"_508":5874,"_510":5875,"_181":512,"_182":5876,"_464":5877},{"_190":190,"_139":4952},{"_139":209},{"_518":5878,"_520":5879,"_20":5880},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_190":5663,"_139":5902},{"_190":5663,"_139":4202},{"_181":5881,"_26":5881,"_5630":5882,"_28":20,"_29":5883,"_5633":5884,"_31":32,"_33":5885,"_525":5885,"_5636":32,"_35":5886},"6aa2a2f138c2bc34962b6fcb","2026-09-10T12:30:41.980Z","260320_ESTHER_02_215 1_(Fredrik Bengtsson).jpg",[],"6aa2a2f1bbd4693496e109da",{"_37":5887,"_39":5888,"_41":5889,"_43":5890,"_45":5891,"_532":5892,"_47":5893},{"_542":5901,"_49":572,"_51":560,"_53":574},{"_542":5900,"_49":568,"_51":5661,"_53":570},{"_542":5899,"_49":564,"_51":5659,"_53":566},{"_542":5898,"_49":560,"_51":5657,"_53":562},{"_542":5897,"_49":556,"_51":5655,"_53":558},{"_542":5895,"_49":552,"_51":5896,"_53":554},{"_49":5894,"_51":540,"_53":541},3201,371792,2559,77798,2254,16798,4872,1882,98,{"_176":5904,"_178":5905,"_464":5906,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[5909,5910,5911],{"_91":5933,"_94":113},{"_91":5915,"_92":5916,"_94":113},{"_91":5912,"_94":113},{"_176":5913,"_178":5914,"_395":396},{"_139":407},{"_139":189},{"_178":5931,"_181":463,"_464":5932,"_185":232},[5917],{"_91":5918,"_94":119},{"_92":5919},[5920],{"_92":5921,"_128":129,"_130":420},[5922,5923,5924,5925,5926],{"_92":5928,"_128":129,"_130":3379},{"_128":144},{"_128":144},{"_128":150,"_150":5927},{"_128":144},"my interest really started around that show in copenhagen. i had bought my first pocket operator a few months earlier and became really obsessed with it. then pontus and the teenage engineering crew introduced me to a whole new world with the OP–Z and the other pocket operators. they really opened the door to synthesizers for me.",[5929],{"_128":150,"_150":5930},"what started your love for synthesizers?",{"_139":209},{"_190":190,"_139":466},{"_176":5934,"_178":5935,"_464":5936,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[5939,5940,5941,5942],{"_91":5997,"_94":113},{"_91":5963,"_94":113},{"_91":5945,"_92":5946,"_94":113},{"_91":5943,"_94":113},{"_176":5944,"_395":396},{"_139":396},{"_181":503},[5947,5948],{"_91":5959,"_94":113},{"_91":5949,"_92":5950,"_94":113},{"_178":5957,"_464":5958,"_185":232},[5951],{"_91":5952,"_94":119},{"_92":5953},[5954],{"_92":5955,"_128":129,"_130":493,"_134":494},[5956],{"_128":144},{"_139":209},{"_139":189},{"_176":5960,"_178":5961,"_464":5962,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":5964,"_178":5965,"_508":5966,"_510":5967,"_181":512,"_182":5968,"_464":5969},{"_190":190,"_139":4952},{"_139":209},{"_518":5970,"_20":5971},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_190":5663,"_139":5902},{"_181":5972,"_26":5972,"_5630":5973,"_28":20,"_29":5974,"_5633":5975,"_31":32,"_33":5976,"_525":5976,"_5636":32,"_35":5977},"6aa2abf5a2c8ea3fb5f67508","2026-09-10T13:09:09.121Z","IMG_3986.jpg",[],"6aa2abf5bde8733fb5c38136",{"_37":5978,"_39":5979,"_41":5980,"_43":5981,"_45":5982,"_532":5983,"_534":5984,"_47":5985},{"_542":5996,"_49":572,"_51":573,"_53":574},{"_542":5995,"_49":568,"_51":4034,"_53":570},{"_542":5994,"_49":564,"_51":565,"_53":566},{"_542":5993,"_49":560,"_51":1910,"_53":562},{"_542":5991,"_49":556,"_51":5992,"_53":558},{"_542":5990,"_49":552,"_51":553,"_53":554},{"_542":5988,"_49":548,"_51":5989,"_53":550},{"_49":5986,"_51":5987,"_53":541},4856,3237,716986,2730,227392,83128,682,5290,30718,11532,4006,{"_176":5998,"_178":5999,"_464":6000,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[6003,6004,6005],{"_91":6035,"_94":113},{"_91":6009,"_92":6010,"_94":113},{"_91":6006,"_94":113},{"_176":6007,"_178":6008,"_395":396},{"_139":407},{"_139":189},{"_178":6033,"_181":463,"_464":6034,"_185":232},[6011],{"_91":6012,"_94":119},{"_92":6013},[6014],{"_92":6015,"_128":129,"_130":420},[6016,6017,6018,6019,6020,6021,6022,6023,6024,6025,6026],{"_92":6030,"_128":129,"_130":3379},{"_128":144},{"_128":144},{"_128":150,"_150":6029},{"_128":144},{"_128":144},{"_128":150,"_150":6028},{"_128":144},{"_128":144},{"_128":150,"_150":6027},{"_128":144},"pontus winnberg was also playing that night. after the show, he came up to me and shook my hand without saying anything. a month later, he asked if i wanted to write music with him. that eventually became the start of a collaboration that’s still going today. i’m genuinely so grateful to teenage engineering. it’s basically because of them that i’m where i am today. it’s probably the most important moment in my career.","during the show, jesper asked me to go on stage and sing and play my vibraphone. he turned off all the other sound outputs and let me finish the show completely on my own. it was the first time i had ever sung and played in front of an audience.","honestly, teenage engineering is a big reason why i’m making music today. i was invited to play with the teenage engineering sound system at haven festival in copenhagen in 2017. jesper, an old family friend, had heard a song i recorded and uploaded to soundcloud featuring me and my vibraphone.",[6031],{"_128":150,"_150":6032},"what’s your history with teenage engineering?",{"_139":209},{"_190":190,"_139":466},{"_176":6036,"_178":6037,"_464":6038,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[6041,6042,6043,6044],{"_91":6098,"_94":113},{"_91":6065,"_94":113},{"_91":6047,"_92":6048,"_94":113},{"_91":6045,"_94":113},{"_176":6046,"_395":396},{"_139":396},{"_181":503},[6049,6050],{"_91":6061,"_94":113},{"_91":6051,"_92":6052,"_94":113},{"_178":6059,"_464":6060,"_185":232},[6053],{"_91":6054,"_94":119},{"_92":6055},[6056],{"_92":6057,"_128":129,"_130":493,"_134":494},[6058],{"_128":144},{"_139":209},{"_139":189},{"_176":6062,"_178":6063,"_464":6064,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":6066,"_178":6067,"_508":6068,"_510":6069,"_181":512,"_182":6070,"_464":6071},{"_190":190,"_139":4952},{"_139":209},{"_20":6072},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_181":6073,"_26":6073,"_5630":6074,"_28":20,"_29":6075,"_5633":6076,"_31":32,"_33":6077,"_525":6077,"_5636":32,"_35":6078},"6aa2a2e42721d234968eda56","2026-09-10T12:30:28.858Z","IMG_4412.jpg",[],"6aa2a2e4e34d1c3496aaf225",{"_37":6079,"_39":6080,"_41":6081,"_43":6082,"_45":6083,"_532":6084,"_534":6085,"_536":6086,"_47":6087},{"_542":6097,"_49":572,"_51":573,"_53":574},{"_542":6096,"_49":568,"_51":569,"_53":570},{"_542":6095,"_49":564,"_51":565,"_53":566},{"_542":6094,"_49":560,"_51":561,"_53":562},{"_542":6093,"_49":556,"_51":557,"_53":558},{"_542":6092,"_49":552,"_51":553,"_53":554},{"_542":6091,"_49":548,"_51":549,"_53":550},{"_542":6090,"_49":544,"_51":545,"_53":546},{"_49":6088,"_51":6089,"_53":541},5616,3744,2162226,1237728,164090,51114,3618,19542,7768,2750,{"_176":6099,"_178":6100,"_464":6101,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[6104,6105,6106],{"_91":6134,"_94":113},{"_91":6110,"_92":6111,"_94":113},{"_91":6107,"_94":113},{"_176":6108,"_178":6109,"_395":396},{"_139":407},{"_139":189},{"_178":6132,"_181":463,"_464":6133,"_185":232},[6112],{"_91":6113,"_94":119},{"_92":6114},[6115],{"_92":6116,"_128":129,"_130":420},[6117,6118,6119,6120,6121,6122,6123],{"_128":150,"_150":6131},{"_92":6126,"_128":132,"_132":6127},{"_128":150,"_150":6125},{"_128":144},{"_128":144},{"_128":150,"_150":6124},{"_128":144},"with her debut album now out, we caught up with esther to talk about how it all started and the process behind it.","”.",[6129],{"_94":434,"_139":6128},"https://open.spotify.com/artist/3POjAYvvEzzCFAWm4uHEza?si=Ya_5W7tlQDatirE09IJB4A",{"_128":150,"_150":6130},"fragmentality","esther has been part of the teenage engineering family for as long as we can remember. in 2017, she became one of the first musicians from outside teenage engineering to join the teenage engineering sound system. two years later, she was featured in the music video for the launch of the pocket operator modular series. she debuted as a solo artist with her critically acclaimed single “follow me home”. and this june, she released her debut album “",{"_139":209},{"_190":190,"_139":466},{"_176":6135,"_178":6136,"_464":6137,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":937},[6140,6141,6142],{"_91":6181,"_92":6182,"_94":2324},{"_91":6145,"_92":6146,"_94":2324},{"_91":6143,"_94":113},{"_176":6144,"_395":396},{"_139":396},{"_2350":142,"_2351":32,"_2352":142},[6147],{"_91":6148,"_94":113},{"_176":6149,"_178":6150,"_14":-5,"_508":6151,"_510":6152,"_182":6153,"_464":6154},{"_139":936},{"_139":189},{"_518":6155,"_520":6156,"_20":6157},{"_139":517},{"_190":190,"_139":515},{"_139":515},{"_190":5663,"_139":1728},{"_190":5663,"_139":6180},{"_181":6158,"_26":6158,"_5630":6159,"_28":20,"_29":6160,"_5633":6161,"_31":32,"_33":6162,"_525":6162,"_5636":32,"_35":6163},"6aa2a2ba7001dc3495540dc0","2026-09-10T12:29:46.247Z","260320_ESTHER_04_177 1_(Fredrik Bengtsson).jpg",[],"6aa2a2ba9cba3834951b1cb6",{"_37":6164,"_39":6165,"_41":6166,"_43":6167,"_45":6168,"_532":6169,"_534":6170,"_536":6171,"_47":6172},{"_542":6179,"_49":572,"_51":560,"_53":574},{"_542":6178,"_49":568,"_51":5661,"_53":570},{"_542":6177,"_49":564,"_51":5659,"_53":566},{"_542":5766,"_49":560,"_51":5657,"_53":562},{"_542":6176,"_49":556,"_51":5655,"_53":558},{"_542":6175,"_49":552,"_51":5653,"_53":554},{"_542":6174,"_49":548,"_51":544,"_53":550},{"_542":6173,"_49":544,"_51":5650,"_53":546},{"_49":5647,"_51":5648,"_53":541},5086412,3541234,725544,127594,21494,6020,2218,101,{"_2350":142,"_2351":142},[6183],{"_91":6184,"_94":113},{"_176":6185,"_178":6186,"_14":-5,"_508":6187,"_510":6188,"_182":6189,"_464":6190},{"_139":936},{"_139":189},{"_518":6191,"_520":6192,"_20":6193},{"_139":517},{"_190":190,"_139":515},{"_139":515},{"_190":5663,"_139":189},{"_190":5663,"_139":6180},{"_181":6158,"_26":6158,"_5630":6159,"_28":20,"_29":6160,"_5633":6194,"_31":32,"_33":6162,"_525":6162,"_5636":32,"_35":6195},[],{"_37":6196,"_39":6197,"_41":6198,"_43":6199,"_45":6200,"_532":6201,"_534":6202,"_536":6203,"_47":6204},{"_542":6179,"_49":572,"_51":560,"_53":574},{"_542":6178,"_49":568,"_51":5661,"_53":570},{"_542":6177,"_49":564,"_51":5659,"_53":566},{"_542":5766,"_49":560,"_51":5657,"_53":562},{"_542":6176,"_49":556,"_51":5655,"_53":558},{"_542":6175,"_49":552,"_51":5653,"_53":554},{"_542":6174,"_49":548,"_51":544,"_53":550},{"_542":6173,"_49":544,"_51":5650,"_53":546},{"_49":5647,"_51":5648,"_53":541},{"_181":985},[6207,6208,6209],{"_91":6249,"_94":113},{"_91":6212,"_92":6213,"_94":113},{"_91":6210,"_94":113},{"_176":6211,"_395":396},{"_139":407},{},[6214,6215],{"_91":6246,"_94":113},{"_91":6216,"_92":6217,"_94":113},{"_178":6245},[6218,6219,6220],{"_91":6235,"_92":6236,"_94":113},{"_91":6231,"_94":113},{"_91":6221,"_92":6222,"_94":113},{"_178":6230,"_185":396},[6223],{"_91":6224,"_94":119},{"_92":6225},[6226],{"_92":6227,"_128":129,"_130":493,"_134":494},[6228],{"_128":150,"_150":6229},"September 10, 2026",{"_139":964},{"_176":6232,"_178":6233,"_182":6234},{"_139":396},{"_139":964},{"_139":407},{"_178":6244,"_185":396},[6237],{"_91":6238,"_94":119},{"_92":6239},[6240],{"_92":6241,"_128":129,"_130":166},[6242],{"_128":150,"_150":6243},"catching up with esther",{"_139":964},{"_139":964},{"_176":6247,"_178":6248},{"_139":232},{"_139":396},{"_176":6250},{"_139":209},"esther",{"_181":6804},[6254,6255,6256,6257,6258,6259,6260,6261,6262,6263],{"_91":6758,"_92":6759,"_94":113},{"_91":6694,"_92":6695,"_94":113},{"_91":6671,"_92":6672,"_94":113},{"_91":6614,"_92":6615,"_94":113},{"_91":6544,"_92":6545,"_94":113},{"_91":6486,"_92":6487,"_94":113},{"_91":6414,"_92":6415,"_94":113},{"_91":6354,"_92":6355,"_94":113},{"_91":6270,"_92":6271,"_94":113},{"_91":6264,"_92":6265,"_94":113},{},[6266],{"_91":6267,"_94":113},{"_176":6268,"_235":6269,"_395":396},{"_139":209},{"_397":142,"_92":398},{"_181":473},[6272,6273,6274,6275,6276],{"_91":6348,"_94":113},{"_91":6329,"_92":6330,"_94":113},{"_91":6310,"_92":6311,"_94":113},{"_91":6280,"_92":6281,"_94":113},{"_91":6277,"_94":113},{"_176":6278,"_178":6279,"_395":396},{"_139":407},{"_139":189},{"_178":6308,"_181":463,"_464":6309,"_185":232},[6282],{"_91":6283,"_94":119},{"_92":6284},[6285,6286],{"_92":6304,"_128":129,"_130":441},{"_92":6287,"_128":129,"_130":420},[6288,6289,6290,6291,6292,6293,6294,6295,6296,6297],{"_128":144},{"_128":150,"_150":6303},{"_128":144},{"_128":144},{"_128":144},{"_128":150,"_150":6302},{"_92":6298,"_128":132,"_132":6299},{"_128":144},{"_128":144},{"_128":144},[6301],{"_94":434,"_139":6300},"https://open.spotify.com/album/2Np10xTQlbyO23QDEMaZzk?si=tRP0WlAQRaiDjK2_GljDDA",{"_128":150,"_150":437},"you can listen to toxes latest album \"bubble treasure\" ","the album is called “bubble treasure” and was released on september 15. most of the songs were written during the second half of last year, although the process started in the summer of 2025. by january, the album was essentially finished. the title comes from one of the songs on the album. i liked that “bubble treasure” sounded like the title of a storybook, and felt that its poetic quality represented the collection as a whole.",[6305,6306],{"_128":150,"_150":6307},{"_128":144},"what can you tell us about the album?",{"_139":209},{"_190":190,"_139":466},{"_178":6327,"_181":463,"_464":6328,"_185":232},[6312],{"_91":6313,"_94":119},{"_92":6314},[6315,6316],{"_92":6323,"_128":129,"_130":441},{"_92":6317,"_128":129,"_130":420},[6318,6319,6320,6321],{"_128":144},{"_128":150,"_150":6322},{"_128":144},{"_128":144},"i try to come back every year, usually once during the summer and again around christmas. it’s nice to return and have some quiet time, and i could see myself living somewhere in sweden again at some point.",[6324,6325],{"_128":150,"_150":6326},{"_128":144},"how often do you return to sweden?",{"_139":209},{"_190":190,"_139":466},{"_178":6346,"_181":463,"_464":6347,"_185":232},[6331],{"_91":6332,"_94":119},{"_92":6333},[6334,6335],{"_92":6342,"_128":129,"_130":441},{"_92":6336,"_128":129,"_130":420},[6337,6338,6339,6340],{"_128":144},{"_128":150,"_150":6341},{"_128":144},{"_128":144},"of course. every place and every person you meet inevitably influences you in some way. i particularly enjoyed living in paris. it was a relatively isolated period, and i spent a lot of time walking, staying at home and making music. that balance made it a very productive period. moving away from sweden also introduced me to new people and environments. when i moved to berlin, i already knew people there through the internet and started working with the berlin label PAN records. being part of that scene at such a young age gave me a lot of support and motivation. later, studying architecture and meeting people outside of music also had a big influence on me. being around people with completely different interests gave me a different perspective.",[6343,6344],{"_128":150,"_150":6345},{"_128":144},"has moving between cities influenced your creativity?",{"_139":209},{"_190":190,"_139":466},{"_176":6349,"_178":6350,"_182":6351,"_464":6352,"_471":142},{"_190":191,"_139":6353},{"_139":232},{"_190":191,"_139":5706},{"_190":190,"_139":472},42,{"_181":20},[6356,6357,6358,6359],{"_91":6410,"_94":113},{"_91":6381,"_94":113},{"_91":6362,"_92":6363,"_94":113},{"_91":6360,"_94":113},{"_176":6361,"_395":396},{"_139":396},{"_181":503},[6364,6365],{"_91":6377,"_94":113},{"_91":6366,"_92":6367,"_94":113},{"_178":6375,"_464":6376,"_185":232},[6368],{"_91":6369,"_94":119},{"_92":6370},[6371],{"_92":6372,"_128":129,"_130":493,"_134":494},[6373,6374],{"_128":144},{"_128":144},{"_139":209},{"_139":189},{"_176":6378,"_178":6379,"_464":6380,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":6382,"_178":6383,"_508":6384,"_510":6385,"_181":512,"_182":6386,"_464":6387},{"_190":190,"_139":4952},{"_139":209},{"_518":6388,"_520":6389,"_20":6390},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_190":5663,"_139":6409},{"_190":5663,"_139":4202},{"_181":6391,"_26":6391,"_5630":6392,"_28":20,"_29":6393,"_5633":6394,"_31":32,"_33":6395,"_525":6395,"_5636":32,"_35":6396},"6abe3dbe539d881e186c28f1","2026-10-01T11:02:22.321Z","toxe_2026_4.jpg",[],"6abe3dbe90d6e11e18029ae2",{"_37":6397,"_39":6398,"_41":6399,"_43":6400,"_45":6401,"_532":6402,"_47":6403},{"_542":6408,"_49":572,"_51":569,"_53":574},{"_542":6407,"_49":568,"_51":565,"_53":570},{"_542":6406,"_49":564,"_51":557,"_53":566},{"_542":688,"_49":560,"_51":3927,"_53":562},{"_542":6405,"_49":556,"_51":553,"_53":558},{"_542":6404,"_49":552,"_51":549,"_53":554},{"_49":1389,"_51":540,"_53":541},234112,65710,22066,8342,3162,27,{"_176":6411,"_178":6412,"_464":6413,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[6416,6417,6418,6419,6420],{"_91":6481,"_94":113},{"_91":6462,"_92":6463,"_94":113},{"_91":6443,"_92":6444,"_94":113},{"_91":6424,"_92":6425,"_94":113},{"_91":6421,"_94":113},{"_176":6422,"_178":6423,"_395":396},{"_139":407},{"_139":189},{"_178":6441,"_181":463,"_464":6442,"_185":232},[6426],{"_91":6427,"_94":119},{"_92":6428},[6429,6430],{"_92":6437,"_128":129,"_130":441},{"_92":6431,"_128":129,"_130":420},[6432,6433,6434,6435],{"_128":144},{"_128":150,"_150":6436},{"_128":144},{"_128":144},"i’m very minimal with my set-up. i started with just my laptop and headphones, and that’s still the foundation of how i work. i really enjoy using the OP–1, which i’ve had for many years. i can sometimes feel intimidated by new gear, but the OP–1 has always been easy and fun for me to use. for live shows, i also use a controller from faderfox for effects and control. once i move, i’d like to get a proper piano. there’s a lot of piano throughout the new album, and i played piano as a child, so i’d like to return to it and start practising again.",[6438,6439],{"_128":150,"_150":6440},{"_128":144},"what does your current set-up look like?",{"_139":209},{"_190":190,"_139":466},{"_178":6460,"_181":463,"_464":6461,"_185":232},[6445],{"_91":6446,"_94":119},{"_92":6447},[6448,6449],{"_92":6456,"_128":129,"_130":441},{"_92":6450,"_128":129,"_130":420},[6451,6452,6453,6454],{"_128":144},{"_128":150,"_150":6455},{"_128":144},{"_128":144},"probably something aquatic. maybe a seahorse. i just really love seahorses.",[6457,6458],{"_128":150,"_150":6459},{"_128":144},"if you had to describe your music as an animal, what would it be?",{"_139":209},{"_190":190,"_139":466},{"_178":6479,"_181":463,"_464":6480,"_185":232},[6464],{"_91":6465,"_94":119},{"_92":6466},[6467,6468],{"_92":6475,"_128":129,"_130":441},{"_92":6469,"_128":129,"_130":420},[6470,6471,6472,6473],{"_128":144},{"_128":150,"_150":6474},{"_128":144},{"_128":144},"i’ve been moving around a lot, so i haven’t had a proper studio set-up for years. i’m looking forward to having a more permanent space when i move to los angeles early next year. i usually enjoy making music most when things happen quickly and naturally. the zombie song was a good example. the idea was very clear, and i didn’t have time to overthink it. when something comes out without being forced, that’s when making music feels the most enjoyable.",[6476,6477],{"_128":150,"_150":6478},{"_128":144},"where do you feel most creative?",{"_139":209},{"_190":190,"_139":466},{"_176":6482,"_178":6483,"_182":6484,"_464":6485,"_471":142},{"_190":191,"_139":192},{"_139":232},{"_190":191,"_139":5706},{"_190":190,"_139":472},{"_181":20},[6488,6489,6490,6491],{"_91":6540,"_94":113},{"_91":6512,"_94":113},{"_91":6494,"_92":6495,"_94":113},{"_91":6492,"_94":113},{"_176":6493,"_395":396},{"_139":396},{"_181":503},[6496,6497],{"_91":6508,"_94":113},{"_91":6498,"_92":6499,"_94":113},{"_178":6506,"_464":6507,"_185":232},[6500],{"_91":6501,"_94":119},{"_92":6502},[6503],{"_92":6504,"_128":129,"_130":493,"_134":494},[6505],{"_128":144},{"_139":209},{"_139":189},{"_176":6509,"_178":6510,"_464":6511,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":6513,"_178":6514,"_508":6515,"_510":6516,"_181":512,"_182":6517,"_464":6518},{"_190":190,"_139":4952},{"_139":209},{"_518":6519,"_20":6520},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_190":5663,"_139":5902},{"_181":6521,"_26":6521,"_5630":6522,"_28":20,"_29":6523,"_5633":6524,"_31":32,"_33":6525,"_525":6525,"_5636":32,"_35":6526},"6abe3da37a2ed51e19fb09cd","2026-10-01T11:01:55.767Z","toxe_2026_2 (1).jpg",[],"6abe3da31f77c41e1942344c",{"_37":6527,"_39":6528,"_41":6529,"_43":6530,"_45":6531,"_532":6532,"_47":6533},{"_542":6539,"_49":572,"_51":3030,"_53":574},{"_542":6538,"_49":568,"_51":787,"_53":570},{"_542":6537,"_49":564,"_51":785,"_53":566},{"_542":6536,"_49":560,"_51":3026,"_53":562},{"_542":6535,"_49":556,"_51":783,"_53":558},{"_542":6534,"_49":552,"_51":779,"_53":554},{"_49":540,"_51":1389,"_53":541},160762,44188,3598,17386,7588,2968,{"_176":6541,"_178":6542,"_464":6543,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[6546,6547,6548,6549,6550],{"_91":6609,"_94":113},{"_91":6590,"_92":6591,"_94":113},{"_91":6571,"_92":6572,"_94":113},{"_91":6554,"_92":6555,"_94":113},{"_91":6551,"_94":113},{"_176":6552,"_178":6553,"_395":396},{"_139":407},{"_139":189},{"_178":6569,"_181":463,"_464":6570,"_185":232},[6556],{"_91":6557,"_94":119},{"_92":6558},[6559],{"_92":6560,"_128":129,"_130":420},[6561,6562,6563,6564],{"_92":6566,"_128":129,"_130":3379},{"_128":144},{"_128":144},{"_128":150,"_150":6565},"it was probably the fastest song to make on the album. i had an instrumental sketch that had been sitting around for a while, and then the lyrics and concept suddenly clicked. i’d wanted to write a song from the perspective of a zombie for a long time. i liked the idea of a zombie slowly losing her mind while still trying to hold on to something romantic and sensual. there’s something tender about that contrast. the instrumental originally had a more ambient sound, but once i had the concept, i changed the production and focused more on piano and a plucky sound that contrasted with the subject matter.",[6567],{"_128":150,"_150":6568},"can you tell us about the process behind your new single “a girl who needs a brain”?",{"_139":209},{"_190":190,"_139":466},{"_178":6588,"_181":463,"_464":6589,"_185":232},[6573],{"_91":6574,"_94":119},{"_92":6575},[6576],{"_92":6577,"_128":129,"_130":420},[6578,6579,6580,6581,6582,6583],{"_92":6585,"_128":129,"_130":3379},{"_128":144},{"_128":144},{"_128":150,"_150":6584},{"_128":144},{"_128":144},"not anymore. we made music together when we were younger, but eventually he moved on to other things. he still loves music, but it’s no longer something he does professionally.",[6586],{"_128":150,"_150":6587},"do you still make music with your brother?",{"_139":209},{"_190":190,"_139":466},{"_178":6607,"_181":463,"_464":6608,"_185":232},[6592],{"_91":6593,"_94":119},{"_92":6594},[6595],{"_92":6596,"_128":129,"_130":420},[6597,6598,6599,6600,6601,6602],{"_92":6604,"_128":129,"_130":3379},{"_128":144},{"_128":144},{"_128":150,"_150":6603},{"_128":144},{"_128":144},"i was born in gothenburg, sweden, and started making music when i was around 14 or 15. my brother was producing music at the time and introduced me to ableton. before that, i played piano and guitar and sang, but he was the one who really opened the door to music production for me. i started making music while i was still in high school, and things gradually developed from there. i began getting gigs and eventually decided to pursue music. i never studied music formally, but started studying architecture in 2021, so i’ve found myself moving between music and design.",[6605],{"_128":150,"_150":6606},"tell us about the world of toxe",{"_139":209},{"_190":190,"_139":466},{"_176":6610,"_178":6611,"_182":6612,"_464":6613,"_471":142},{"_190":191,"_139":192},{"_139":232},{"_190":191,"_139":5706},{"_190":190,"_139":472},{"_181":20},[6616,6617,6618,6619],{"_91":6667,"_94":113},{"_91":6640,"_94":113},{"_91":6622,"_92":6623,"_94":113},{"_91":6620,"_94":113},{"_176":6621,"_395":396},{"_139":396},{"_181":503},[6624,6625],{"_91":6636,"_94":113},{"_91":6626,"_92":6627,"_94":113},{"_178":6634,"_464":6635,"_185":232},[6628],{"_91":6629,"_94":119},{"_92":6630},[6631],{"_92":6632,"_128":129,"_130":493,"_134":494},[6633],{"_128":144},{"_139":209},{"_139":189},{"_176":6637,"_178":6638,"_464":6639,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":6641,"_178":6642,"_508":6643,"_510":6644,"_181":512,"_182":6645,"_464":6646},{"_190":190,"_139":4952},{"_139":209},{"_20":6647},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_181":6648,"_26":6648,"_5630":6649,"_28":20,"_29":6650,"_5633":6651,"_31":32,"_33":6652,"_525":6652,"_5636":32,"_35":6653},"6abe3dbc28db651e17708dfa","2026-10-01T11:02:20.111Z","toxe_2026_3.jpg",[],"6abe3dbcec4b541e17fbb67d",{"_37":6654,"_39":6655,"_41":6656,"_43":6657,"_45":6658,"_532":6659,"_47":6660},{"_542":6666,"_49":572,"_51":3030,"_53":574},{"_542":6665,"_49":568,"_51":787,"_53":570},{"_542":6664,"_49":564,"_51":785,"_53":566},{"_542":6663,"_49":560,"_51":3026,"_53":562},{"_542":6662,"_49":556,"_51":783,"_53":558},{"_542":6661,"_49":552,"_51":779,"_53":554},{"_49":540,"_51":1389,"_53":541},150310,47538,2822,17138,6084,2258,{"_176":6668,"_178":6669,"_464":6670,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[6673,6674,6675],{"_91":6690,"_94":113},{"_91":6679,"_92":6680,"_94":113},{"_91":6676,"_94":113},{"_176":6677,"_178":6678,"_395":396},{"_139":407},{"_139":189},{"_178":6688,"_181":463,"_464":6689,"_185":232},[6681],{"_91":6682,"_94":119},{"_92":6683},[6684],{"_92":6685,"_128":129,"_130":420},[6686],{"_128":150,"_150":6687},"based between new york and a series of cities that have shaped her along the way, toxe has built a practice that moves between music, visuals and architecture. after moving from gothenburg to berlin at 18, she became part of the city’s music scene while developing her own self-produced work. today, she continues to work independently, handling everything from production to visuals. with the new album “bubble treasure” out now, we sat down a few days before its release to talk about moving between cities, finding inspiration in unexpected places, and creating a world entirely of her own.",{"_139":209},{"_190":190,"_139":466},{"_176":6691,"_178":6692,"_464":6693,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":937},[6696,6697,6698],{"_91":6736,"_92":6737,"_94":2324},{"_91":6701,"_92":6702,"_94":2324},{"_91":6699,"_94":113},{"_176":6700,"_395":396},{"_139":396},{"_2350":142,"_2351":32,"_2352":142},[6703],{"_91":6704,"_94":113},{"_176":6705,"_178":6706,"_14":-5,"_508":6707,"_180":142,"_510":6708,"_182":6709,"_464":6710},{"_139":936},{"_139":189},{"_2685":6711,"_518":6712,"_520":6713,"_20":6714},{"_139":517},{"_190":190,"_139":515},{"_139":515},{"_190":5663,"_139":6735},{"_190":5663,"_139":1728},{"_190":5663,"_139":6734},{"_181":6715,"_26":6715,"_5630":6716,"_28":20,"_29":6717,"_5633":6718,"_31":32,"_33":6719,"_5