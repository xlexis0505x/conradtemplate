178":3872,"_181":463,"_464":3873,"_185":232},[3792],{"_91":3793,"_94":119},{"_92":3794},[3795,3796,3797,3798,3799,3800,3801],{"_92":3867,"_128":129,"_130":441},{"_92":3863,"_128":129,"_130":420},{"_92":3858,"_128":129,"_130":441},{"_92":3854,"_128":129,"_130":420},{"_92":3849,"_128":129,"_130":441},{"_92":3802,"_128":129,"_130":420},{"_128":129,"_130":441},[3803,3804,3805,3806,3807,3808,3809,3810,3811,3812,3813,3814,3815,3816,3817,3818,3819],{"_128":150,"_150":3848},{"_128":144},{"_128":144},{"_128":144},{"_128":150,"_150":3847},{"_92":3844,"_128":129,"_134":3834},{"_92":3837,"_128":129,"_134":3834},{"_92":3833,"_128":129,"_134":3834},{"_128":144},{"_128":144},{"_128":144},{"_128":150,"_150":3826},{"_92":3827,"_128":132,"_132":3828},{"_128":144},{"_128":150,"_150":3826},{"_92":3820,"_128":132,"_132":3821},{"_128":144},[3824],{"_136":3822,"_94":434,"_139":3823},{"_148":142},"https://soundcloud.com/dj_haydn",{"_128":150,"_150":3825},"soundcloud","dj haydn on ",[3831],{"_136":3829,"_94":434,"_139":3830},{"_148":142},"https://open.spotify.com/artist/4XC4oNp1V0YjK1Z4ryzaf2?si=zkRCOgzsQJ-tINBkB4hSvQ",{"_128":150,"_150":3832},"spotify",[3835],"font-size: 15.5204px;",{"_128":150,"_150":3836},".",[3838],{"_92":3839,"_128":132,"_132":3840},[3843],{"_136":3841,"_94":434,"_139":3842},{"_148":142},"https://open.spotify.com/track/7htSHMNV2zZVbJolG9hXb8?si=fcd33d8c7b0546e8",{"_128":150,"_150":437},[3845],{"_128":150,"_150":3846},"you can listen to it ","dj haydn just released the first single from his upcoming album, bring the drama. ","it’s a three-course, for sure.",[3850,3851,3852],{"_128":144},{"_128":150,"_150":3853},{"_128":144},"if you were to describe your music as a dish, what would it be? ",[3855,3856],{"_128":150,"_150":3857},{"_128":144},"sofftronic, otiys, akahugo, brenda el rayes, kornél kovács, b12: these people keep pushing their own sound and the creative boundaries around them, whether they realize it or not. it’s really liberating to see, hear, and feel. especially up close.",[3859,3860,3861],{"_128":144},{"_128":150,"_150":3862},{"_128":144},"who inspires you the most at the moment? ",[3864,3865],{"_128":150,"_150":3866},{"_128":144},"i try to keep things pretty straightforward and fluid, at least right now. i’ve been glued to my tascam 244 lately, along with my octatrack, my OP–XY, and my TP–7.",[3868,3869,3870],{"_128":150,"_150":3871},{"_128":144},{"_128":144},"what does your setup look like?",{"_139":209},{"_190":190,"_139":466},{"_176":3875,"_178":3876,"_464":3877,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[3880,3881,3882,3883],{"_91":3931,"_94":113},{"_91":3905,"_94":113},{"_91":3886,"_92":3887,"_94":113},{"_91":3884,"_94":113},{"_176":3885,"_395":396},{"_139":396},{"_181":503},[3888,3889],{"_91":3901,"_94":113},{"_91":3890,"_92":3891,"_94":113},{"_178":3899,"_464":3900,"_185":232},[3892],{"_91":3893,"_94":119},{"_92":3894},[3895],{"_92":3896,"_128":129,"_130":493,"_134":494},[3897,3898],{"_128":144},{"_128":144},{"_139":209},{"_139":189},{"_176":3902,"_178":3903,"_464":3904,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":3906,"_178":3907,"_508":3908,"_510":3909,"_181":512,"_182":3910,"_464":3911},{"_190":190,"_139":1463},{"_139":209},{"_518":3912,"_20":3913},{"_139":3234},{"_190":191,"_139":2684},{"_190":190,"_139":515},{"_139":2101},{"_181":3914,"_26":3914,"_28":20,"_31":32,"_33":3915,"_525":3915,"_35":3916},"6a0ed4a48e0d6d211d12b1b9","6a0ed4a482d513211d490125",{"_37":3917,"_39":3918,"_41":3919,"_43":3920,"_45":3921,"_532":3922,"_47":3923},{"_542":3930,"_49":572,"_51":569,"_53":574},{"_542":3929,"_49":568,"_51":565,"_53":570},{"_542":3928,"_49":564,"_51":557,"_53":566},{"_542":3926,"_49":560,"_51":3927,"_53":562},{"_542":3925,"_49":556,"_51":553,"_53":558},{"_542":3924,"_49":552,"_51":549,"_53":554},{"_49":777,"_51":548,"_53":541},807386,145540,2686,213,18964,5468,2296,{"_176":3932,"_178":3933,"_464":3934,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[3937,3938,3939],{"_91":3973,"_94":113},{"_91":3943,"_92":3944,"_94":113},{"_91":3940,"_94":113},{"_176":3941,"_178":3942,"_395":396},{"_139":407},{"_139":189},{"_178":3971,"_181":463,"_464":3972,"_185":232},[3945],{"_91":3946,"_94":119},{"_92":3947},[3948,3949,3950,3951],{"_92":3968,"_128":129,"_130":441},{"_92":3961,"_128":129,"_130":420},{"_92":3958,"_128":129,"_130":441},{"_92":3952,"_128":129,"_130":420},[3953,3954,3955,3956],{"_128":144},{"_128":150,"_150":3957},{"_128":144},{"_128":144},"everything feels meant to be sampled, in a way. i don’t really believe in ownership of sound. you can’t bottle up air and sell it… ethically. i’m sure there’s some idiot in la working on that too, but that’s not gonna stop me from breathing. i’ve always wanted to twist and feel every sound i hear, so nothing has ever felt too strange or off-limits to sample. that said, i do think there’s a responsibility. you need to be able to stand behind what you use. whether it’s an old composer or a piece of nature, it has to earn its place in what you’re making. i once made a snare by throwing a rock at a wind turbine. the reverb inside it was kind of insane, actually. that one felt good.",[3959],{"_128":150,"_150":3960},"what’s the most unexpected thing you've sampled in a track?",[3962,3963,3964,3965,3966],{"_128":144},{"_128":150,"_150":3967},{"_128":144},{"_128":144},{"_128":144},"i’m very visually inspired. a lot of my ideas come from things i see or experience, and then i try to translate that into a sonic environment. i also get random eureka moments listening to P2 while doing the dishes, lol.",[3969],{"_128":150,"_150":3970},"where do you find inspiration?",{"_139":209},{"_190":190,"_139":466},{"_176":3974,"_178":3975,"_464":3976,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[3979,3980,3981,3982],{"_91":4037,"_94":113},{"_91":4004,"_94":113},{"_91":3985,"_92":3986,"_94":113},{"_91":3983,"_94":113},{"_176":3984,"_395":396},{"_139":396},{"_181":503},[3987,3988],{"_91":4000,"_94":113},{"_91":3989,"_92":3990,"_94":113},{"_178":3998,"_464":3999,"_185":232},[3991],{"_91":3992,"_94":119},{"_92":3993},[3994],{"_92":3995,"_128":129,"_130":493,"_134":494},[3996,3997],{"_128":144},{"_128":144},{"_139":209},{"_139":189},{"_176":4001,"_178":4002,"_464":4003,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":4005,"_178":4006,"_508":4007,"_510":4008,"_181":512,"_182":4009,"_464":4010},{"_190":190,"_139":4036},{"_139":209},{"_518":4011,"_20":4012},{"_139":3234},{"_190":191,"_139":2684},{"_190":190,"_139":515},{"_139":4035},{"_181":4013,"_26":4013,"_28":20,"_31":32,"_33":4014,"_525":4014,"_35":4015},"6a0ed4a4f9f853211d9c06d6","6a0ed4a4e01f88211d8d9db3",{"_37":4016,"_39":4017,"_41":4018,"_43":4019,"_45":4020,"_532":4021,"_47":4022},{"_542":4033,"_49":572,"_51":4034,"_53":574},{"_542":4031,"_49":568,"_51":4032,"_53":570},{"_542":4029,"_49":564,"_51":4030,"_53":566},{"_542":4028,"_49":560,"_51":3927,"_53":562},{"_542":4026,"_49":556,"_51":4027,"_53":558},{"_542":4024,"_49":552,"_51":4025,"_53":554},{"_49":4023,"_51":548,"_53":541},3087,427584,2717,88838,1359,2370,17344,680,5184,340,2060,170,42.7,297,{"_176":4038,"_178":4039,"_464":4040,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[4043,4044,4045],{"_91":4079,"_94":113},{"_91":4049,"_92":4050,"_94":113},{"_91":4046,"_94":113},{"_176":4047,"_178":4048,"_395":396},{"_139":407},{"_139":189},{"_178":4077,"_181":463,"_464":4078,"_185":232},[4051],{"_91":4052,"_94":119},{"_92":4053},[4054,4055,4056,4057],{"_92":4074,"_128":129,"_130":441},{"_92":4067,"_128":129,"_130":420},{"_92":4064,"_128":129,"_130":441},{"_92":4058,"_128":129,"_130":420},[4059,4060,4061,4062],{"_128":144},{"_128":150,"_150":4063},{"_128":144},{"_128":144},"the cd player at home was always warm when i was growing up. it was either hendrix, massive attack, afx, or my sister’s tlc records. i remember really digging into it when i started noticing the difference between sampled tracks and live-played ones. i got my dad to explain sampling and looping in detail, and i guess that’s when it clicked, i just needed to know more. i still don’t fully get it, but i like that.  it’s cool in theory.",[4065],{"_128":150,"_150":4066},"what got you into making music?",[4068,4069,4070,4071,4072],{"_128":144},{"_128":150,"_150":4073},{"_128":144},{"_128":144},{"_128":144},"i was obsessed with dj screw when i was a kid, and it pretty quickly felt like you had to have “dj” in front of your name. haydn, i picked that up from some rom-com. it’s been with me since my teens, so i don’t really think about it anymore. you grow a bit distant from it after a while. people often send me photos of classical haydn (you know, the other guy) records, though, and i love that they’re thinking of me when they’re out browsing.",[4075],{"_128":150,"_150":4076},"what’s the story behind the name dj haydn?",{"_139":209},{"_190":190,"_139":466},{"_176":4080,"_178":4081,"_464":4082,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[4085,4086,4087,4088],{"_91":4133,"_94":113},{"_91":4110,"_94":113},{"_91":4091,"_92":4092,"_94":113},{"_91":4089,"_94":113},{"_176":4090,"_395":396},{"_139":396},{"_181":503},[4093,4094],{"_91":4106,"_94":113},{"_91":4095,"_92":4096,"_94":113},{"_178":4104,"_464":4105,"_185":232},[4097],{"_91":4098,"_94":119},{"_92":4099},[4100],{"_92":4101,"_128":129,"_130":493,"_134":494},[4102,4103],{"_128":144},{"_128":144},{"_139":209},{"_139":189},{"_176":4107,"_178":4108,"_464":4109,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":4111,"_178":4112,"_508":4113,"_510":4114,"_181":512,"_182":4115,"_464":4116},{"_190":190,"_139":4036},{"_139":209},{"_20":4117},{"_139":3234},{"_190":191,"_139":2684},{"_190":190,"_139":515},{"_181":4118,"_26":4118,"_28":20,"_31":32,"_33":4119,"_525":4119,"_35":4120},"6a0ed4a4eb261120dcf387c3","6a0ed4a452733720dc91bfd1",{"_37":4121,"_39":4122,"_41":4123,"_43":4124,"_45":4125,"_532":4126,"_47":4127},{"_542":4132,"_49":572,"_51":5