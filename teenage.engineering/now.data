},[4826],{"_91":4827,"_94":119},{"_92":4828},[4829],{"_92":4830,"_128":129,"_130":493,"_134":494},[4831,4832,4833,4834],{"_128":144},{"_128":150,"_150":4836},{"_128":144},{"_128":150,"_150":4835},"all audio in the video is recorded from a record made with the APC–2.","a phonocut session with shimmer, recorded with CM–15, Tx–6 and Tp–7 at supersense in vienna. ",{"_139":189},{"_176":4845,"_178":4846,"_180":142,"_510":4847,"_181":512,"_182":4848,"_464":4849},[4840],{"_91":4841,"_94":1828},{"_3286":4842,"_3288":32,"_3289":142,"_1828":4843,"_3293":32,"_3294":142},"6a54d65ccd0cf61f00cb3752",{"_29":4844},"APC–2_Master",{"_190":190,"_139":2604},{"_190":190,"_139":1823},{"_139":189},{"_190":191,"_139":188},{"_190":92,"_139":189},{"_176":4851,"_178":4852},{"_139":396},{"_139":232},{"_181":473},[4855,4856,4857],{"_91":4893,"_94":113},{"_91":4861,"_92":4862,"_94":113},{"_91":4858,"_94":113},{"_176":4859,"_178":4860,"_395":396},{"_139":407},{"_139":189},{"_178":4891,"_181":463,"_464":4892,"_185":232},[4863],{"_91":4864,"_94":119},{"_92":4865},[4866,4867,4868],{"_92":4878,"_128":129,"_130":420},{"_92":4871,"_128":129,"_130":420,"_132":4872},{"_92":4869,"_128":129,"_130":420},[4870],{"_128":144},[4875,4876],{"_136":4873,"_94":11,"_139":4874},{"_148":32},"products/apc-2",{"_128":150,"_150":4877},{"_128":144},"explore APC–2",[4879,4880,4881,4882,4883],{"_128":150,"_150":4890},{"_92":4884,"_128":129,"_132":4885},{"_128":150,"_150":3836},{"_128":144},{"_128":144},[4888],{"_136":4886,"_94":434,"_139":4887},{"_148":142},"https://the.supersense.com/products/shimmer-phonocut-live-session",{"_128":150,"_150":4889},"SUPERSENSE","at the beginning of june, we soft-launched the machine at SUPERSENSE’s premises in vienna. we invited one of our close friends, Shimmer, who performed for the guests while being recorded live to disc. this marked the first time the machine had been shown in public, working in real time. this record is available at ",{"_139":209},{"_190":190,"_139":466},{"_176":4894,"_178":4895,"_464":4896,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[4899,4900,4901,4902],{"_91":4953,"_94":113},{"_91":4925,"_94":113},{"_91":4905,"_92":4906,"_94":113},{"_91":4903,"_94":113},{"_176":4904,"_395":396},{"_139":396},{"_181":503},[4907,4908],{"_91":4921,"_94":113},{"_91":4909,"_92":4910,"_94":113},{"_178":4919,"_464":4920,"_185":232},[4911],{"_91":4912,"_94":119},{"_92":4913},[4914],{"_92":4915,"_128":129,"_130":493,"_134":494},[4916,4917],{"_128":144},{"_128":150,"_150":4918},"shimmer performing at supersense",{"_139":209},{"_139":189},{"_176":4922,"_178":4923,"_464":4924,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":4926,"_178":4927,"_508":4928,"_510":4929,"_181":512,"_182":4930,"_464":4931},{"_190":190,"_139":4952},{"_139":209},{"_518":4932,"_520":4933,"_20":4934},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_139":2101},{"_139":4951},{"_181":4935,"_26":4935,"_28":20,"_31":32,"_33":4936,"_525":4936,"_35":4937},"6a50a7d67ab9457ef420d7ea","6a50a7d695c0247ef4a2aca3",{"_37":4938,"_39":4939,"_41":4940,"_43":4941,"_45":4942,"_532":4943,"_47":4944},{"_542":4950,"_49":572,"_51":3323,"_53":574},{"_542":4949,"_49":568,"_51":3321,"_53":570},{"_542":4948,"_49":564,"_51":3319,"_53":566},{"_542":4947,"_49":560,"_51":3317,"_53":562},{"_542":4946,"_49":556,"_51":3315,"_53":558},{"_542":4945,"_49":552,"_51":3313,"_53":554},{"_49":3021,"_51":3585,"_53":54},218670,33852,1922,9390,3728,1622,124.5,290,{"_176":4954,"_178":4955,"_464":4956,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[4959,4960,4961],{"_91":4990,"_94":113},{"_91":4965,"_92":4966,"_94":113},{"_91":4962,"_94":113},{"_176":4963,"_178":4964,"_395":396},{"_139":407},{"_139":189},{"_178":4988,"_181":463,"_464":4989,"_185":232},[4967],{"_91":4968,"_94":119},{"_92":4969},[4970,4971,4972],{"_92":4984,"_128":129,"_130":420},{"_92":4982,"_128":129,"_130":441},{"_92":4973,"_128":129,"_130":420},[4974,4975,4976,4977,4978,4979],{"_128":150,"_150":4981},{"_128":144},{"_128":144},{"_128":150,"_150":4980},{"_128":144},{"_128":144},"it’s very much in line with our philosophy: offering tools that cover the entire process, from creating music to producing the physical format. and what’s exciting is that this isn’t niche. everyone understands what a record is. this connects with people in a very direct way.”","i don’t yet know exactly how it scales globally, but that’s the direction. it’s about changing the relationship people have with records. at the same time, we want to introduce the machine slowly, learn from it, and understand how people actually want to use it. what do they make? what do they need? how can we move beyond the limits of the old system?",[4983],{"_128":144},[4985,4986],{"_128":150,"_150":4987},{"_128":144},"this is about accessibility: small editions, records on demand, different shapes and sizes, made anywhere. we’ve already seen glimpses of this, capturing a live performance and turning it into a physical record shortly after. that kind of immediacy simply wasn’t possible before. it’s about creating a new environment for making records. not factories, but beautiful spaces where sound can be captured and turned into a physical object in the same moment.",{"_139":209},{"_190":190,"_139":466},{"_176":4991,"_178":4992,"_464":4993,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[4996,4997,4998,4999],{"_91":5051,"_94":113},{"_91":5022,"_94":113},{"_91":5002,"_92":5003,"_94":113},{"_91":5000,"_94":113},{"_176":5001,"_395":396},{"_139":396},{"_181":503},[5004,5005],{"_91":5018,"_94":113},{"_91":5006,"_92":5007,"_94":113},{"_178":5016,"_464":5017,"_185":232},[5008],{"_91":5009,"_94":119},{"_92":5010},[5011],{"_92":5012,"_128":129,"_130":493,"_134":494},[5013,5014],{"_128":144},{"_128":150,"_150":5015},"florian, founder of supersense, and oscar, chief development officer",{"_139":209},{"_139":189},{"_176":5019,"_178":5020,"_464":5021,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":5023,"_178":5024,"_508":5025,"_510":5026,"_181":512,"_182":5027,"_464":5028},{"_190":190,"_139":4952},{"_139":209},{"_518":5029,"_520":5030,"_20":5031},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_139":2101},{"_139":3614},{"_181":5032,"_26":5032,"_28":20,"_31":32,"_33":5033,"_525":5033,"_35":5034},"6a462f0d2126a07d8ed6b3e4","6a462f0d0661047d8ed3c470",{"_37":5035,"_39":5036,"_41":5037,"_43":5038,"_45":5039,"_532":5040,"_534":5041,"_47":5042},{"_542":5050,"_49":572,"_51":573,"_53":574},{"_542":5049,"_49":568,"_51":569,"_53":570},{"_542":5048,"_49":564,"_51":565,"_53":566},{"_542":5047,"_49":560,"_51":561,"_53":562},{"_542":5046,"_49":556,"_51":557,"_53":558},{"_542":5044,"_49":552,"_51":5045,"_53":554},{"_542":5043,"_49":548,"_51":549,"_53":550},{"_49":548,"_51":549,"_53":541},2484198,350530,1366,50838,3288,17814,6734,2602,{"_176":5052,"_178":5053,"_464":5054,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[5057,5058,5059],{"_91":5081,"_94":113},{"_91":5063,"_92":5064,"_94":113},{"_91":5060,"_94":113},{"_176":5061,"_178":5062,"_395":396},{"_139":407},{"_139":189},{"_178":5079,"_181":463,"_464":5080,"_185":232},[5065],{"_91":5066,"_94":119},{"_92":5067},[5068,5069],{"_92":5076,"_128":129,"_130":441},{"_92":5070,"_128":129,"_130":420},[5071,5072,5073,5074],{"_128":144},{"_128":150,"_150":5075},{"_128":144},{"_128":144},"“it might sound ambitious, but the dream is clear: that this machine will lead to millions of records that would never have existed through traditional pressing plants. we’re not trying to compete with large-scale production. we’re opening up something different.",[5077],{"_128":150,"_150":5078},"we spoke with florian (founder of SUPERSENSE), oscar (chief development officer), and tomas (senior software developer), all of whom are behind our new industrial record cutter. what is their vision for the future of the APC–2?",{"_139":209},{"_190":190,"_139":466},{"_176":5082,"_178":5083,"_464":5084,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[5087,5088,5089,5090],{"_91":5145,"_94":113},{"_91":5111,"_94":113},{"_91":5093,"_92":5094,"_94":113},{"_91":5091,"_94":113},{"_176":5092,"_395":396},{"_139":396},{"_181":503},[5095,5096],{"_91":5107,"_94":113},{"_91":5097,"_92":5098,"_94":113},{"_178":5105,"_464":5106,"_185":232},[5099],{"_91":5100,"_94":119},{"_92":5101},[5102],{"_92":5103,"_128":129,"_130":493,"_134":494},[5104],{"_128":144},{"_139":209},{"_139":189},{"_176":5108,"_178":5109,"_464":5110,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":5112,"_178":5113,"_508":5114,"_510":5115,"_181":512,"_182":5116,"_464":5117},{"_190":190,"_139":4952},{"_139":209},{"_518":5118,"_520":5119,"_20":5120},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_139":2101},{"_139":4951},{"_181":5121,"_26":5121,"_28":20,"_31":32,"_33":5122,"_525":5122,"_35":5123},"6a4785c9dcb66e22bba7f6c5","6a4785c92562e122bb2f3a03",{"_37":5124,"_39":5125,"_41":5126,"_43":5127,"_45":5128,"_532":5129,"_47":5130},{"_542":5143,"_49":572,"_51":5144,"_53":574},{"_542":5141,"_49":568,"_51":5142,"_53":570},{"_542":5139,"_49":564,"_51":5140,"_53":566},{"_542":5137,"_49":560,"_51":5138,"_53":562},{"_542":5135,"_49":556,"_51":5136,"_53":558},{"_542":5133,"_49":552,"_51":5134,"_53":554},{"_49":5131,"_51":5132,"_53":541},3250,2194,91054,1383,35060,691,2710,108,14706,346,5876,173,2274,86,{"_176":5146,"_178":5147,"_464":5148,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[5151,5152,5153],{"_91":5170,"_94":113},{"_91":5157,"_92":5158,"_94":113},{"_91":5154,"_94":113},{"_176":5155,"_178":5156,"_395":396},{"_139":407},{"_139":189},{"_178":5168,"_181":463,"_464":5169,"_185":232},[5159],{"_91":5160,"_94":119},{"_92":5161},[5162],{"_92":5163,"_128":129,"_130":420},[5164,5165,5166],{"_128":150,"_150":5167},{"_128":144},{"_128":144},"but what makes the APC–2 interesting isn’t only how it works. it’s what it makes possible. traditionally, cutting a record meant entering a closed system that required access, approval, a record label, and resources. for a long time, the machine itself acted as a gatekeeper. we hope the APC–2 can begin to remove that barrier. in that sense, the APC–2 modernizes record cutting and changes who gets to do it, and how.",{"_139":209},{"_190":190,"_139":466},{"_176":5171,"_178":5172,"_464":5173,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[5176,5177,5178,5179],{"_91":5226,"_94":113},{"_91":5202,"_94":113},{"_91":5182,"_92":5183,"_94":113},{"_91":5180,"_94":113},{"_176":5181,"_395":396},{"_139":396},{"_181":503},[5184,5185],{"_91":5198,"_94":113},{"_91":5186,"_92":5187,"_94":113},{"_178":5196,"_464":5197,"_185":232},[5188],{"_91":5189,"_94":119},{"_92":5190},[5191],{"_92":5192,"_128":129,"_130":493,"_134":494},[5193,5194],{"_128":144},{"_128":150,"_150":5195},"the first APC–2, on display at supersense in vienna",{"_139":209},{"_139":189},{"_176":5199,"_178":5200,"_464":5201,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":5203,"_178":5204,"_508":5205,"_510":5206,"_181":512,"_182":5207,"_464":5208},{"_190":190,"_139":4952},{"_139":209},{"_20":5209},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_181":5210,"_26":5210,"_28":20,"_31":32,"_33":5211,"_525":5211,"_35":5212},"6a4785c9912ed522bbd1c387","6a4785c9ef5fb222bb5e0089",{"_37":5213,"_39":5214,"_41":5215,"_43":5216,"_45":5217,"_532":5218,"_47":5219},{"_542":5225,"_49":572,"_51":5144,"_53":574},{"_542":5224,"_49":568,"_51":5142,"_53":570},{"_542":5223,"_49":564,"_51":5140,"_53":566},{"_542":5222,"_49":560,"_51":5138,"_53":562},{"_542":5221,"_49":556,"_51":5136,"_53":558},{"_542":5220,"_49":552,"_51":5134,"_53":554},{"_49":5131,"_51":5132,"_53":541},91646,26100,1768,8632,3512,1492,{"_176":5227,"_178":5228,"_464":5229,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[5232,5233,5234],{"_91":5255,"_94":113},{"_91":5238,"_92":5239,"_94":113},{"_91":5235,"_94":113},{"_176":5236,"_178":5237,"_395":396},{"_139":407},{"_139":189},{"_178":5253,"_181":463,"_464":5254,"_185":232},[5240],{"_91":5241,"_94":119},{"_92":5242},[5243],{"_92":5244,"_128":129,"_130":420},[5245,5246,5247,5248,5249,5250],{"_128":150,"_150":5252},{"_128":144},{"_128":144},{"_128":150,"_150":5251},{"_128":144},{"_128":144},"the machine includes a vacuum suction system that holds the record in place while cutting, a custom-designed tonearm for playback, and Wi-Fi-based configuration. it also has a built-in amplifier, power supply, and vacuum pump. all in one system.","the APC–2 project is a collaboration with our friends at SUPERSENSE. it is designed to produce original playback discs with superior sound quality in real time. it is more affordable than industry-standard machines, easier to use, and suited to serial production.",{"_139":209},{"_190":190,"_139":466},{"_176":5256,"_178":5257,"_464":5258,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[5261,5262,5263,5264],{"_91":5311,"_94":113},{"_91":5287,"_94":113},{"_91":5267,"_92":5268,"_94":113},{"_91":5265,"_94":113},{"_176":5266,"_395":396},{"_139":396},{"_181":503},[5269,5270],{"_91":5283,"_94":113},{"_91":5271,"_92":5272,"_94":113},{"_178":5281,"_464":5282,"_185":232},[5273],{"_91":5274,"_94":119},{"_92":5275},[5276],{"_92":5277,"_128":129,"_130":493,"_134":494},[5278,5279],{"_128":144},{"_128":150,"_150":5280},"the APC–2 custom tonearm",{"_139":209},{"_139":189},{"_176":5284,"_178":5285,"_464":5286,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":5288,"_178":5289,"_508":5290,"_510":5291,"_181":512,"_182":5292,"_464":5293},{"_190":190,"_139":4952},{"_139":209},{"_20":5294},{"_139":3234},{"_190":191,"_139":1893},{"_190":190,"_139":515},{"_181":5295,"_26":5295,"_28":20,"_31":32,"_33":5296,"_525":5296,"_35":5297},"6a4785c9ad3b7322bbd9a69f","6a4785c961b2fe22bbed08d7",{"_37":5298,"_39":5299,"_41":5300,"_43":5301,"_45":5302,"_532":5303,"_47":5304},{"_542":5310,"_49":572,"_51":5144,"_53":574},{"_542":5309,"_49":568,"_51":5142,"_53":570},{"_542":5308,"_49":564,"_51":5140,"_53":566},{"_542":5307,"_49":560,"_51":5138,"_53":562},{"_542":5306,"_49":556,"_51":5136,"_53":558},{"_542":5305,"_49":552,"_51":5134,"_53":554},{"_49":5131,"_51":5132,"_53":541},130552,28256,1840,9522,3696,1594,{"_176":5312,"_178":5313,"_464":5314,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[5317,5318,5319],{"_91":5343,"_94":113},{"_91":5323,"_92":5324,"_94":113},{"_91":5320,"_94":113},{"_176":5321,"_178":5322,"_395":396},{"_139":407},{"_139":189},{"_178":5341,"_181":463,"_464":5342,"_185":232},[5325],{"_91":5326,"_94":119},{"_92":5327},[5328,5329],{"_92":5338,"_128":129,"_130":441},{"_92":5330,"_128":129,"_130":420},[5331,5332,5333,5334,5335],{"_128":144},{"_128":150,"_150":5337},{"_128":144},{"_128":144},{"_128":150,"_150":5336},"swiss inventor flo kaufmann, is one of the few experts capable of repeatedly building cutting heads that match or even surpass the historic originals. his DIALBA cutting heads, used also in SUPERSENSE’s MASTERCUT machines, demonstrated this ability, though each one remains highly time-consuming to produce and production is limited. recreating a new cutting head from scratch is a massive undertaking, with uncertain results.","the industry continues to rely heavily on restored vintage lathes, such as the neumann VMS70 and VMS80, while the pool of technical expertise needed to maintain them keeps shrinking. building a new cutting lathe has never been easy. many have tried and failed. companies like neumann spent decades refining the cutting head. that knowledge is partly lost and partly held by a very small number of specialists. ",[5339],{"_128":150,"_150":5340},"why did we decide to engineer our own professional record cutter?",{"_139":209},{"_190":190,"_139":466},{"_176":5344,"_178":5345,"_464":5346,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":937},[5349,5350,5351],{"_91":5388,"_92":5389,"_94":2324},{"_91":5354,"_92":5355,"_94":2324},{"_91":5352,"_94":113},{"_176":5353,"_395":396},{"_139":396},{"_2350":142,"_2351":32,"_2352":142},[5356],{"_91":5357,"_94":113},{"_176":5358,"_178":5359,"_14":507,"_508":5360,"_510":5361,"_182":5362,"_464":5363},{"_139":936},{"_139":189},{"_518":5364,"_520":5365,"_20":5366},{"_139":517},{"_190":190,"_139":515},{"_139":515},{"_139":5387},{"_139":5386},{"_181":5367,"_26":5367,"_28":20,"_31":32,"_33":5368,"_525":5368,"_35":5369},"6a54af554d8dd9796eded4a2","6a54af55e15fb9796eb9647b",{"_37":5370,"_39":5371,"_41":5372,"_43":5373,"_45":5374,"_532":5375,"_534":5376,"_47":5377},{"_542":5385,"_49":572,"_51":572,"_53":574},{"_542":5384,"_49":568,"_51":568,"_53":570},{"_542":5383,"_49":564,"_51":564,"_53":566},{"_542":5382,"_49":560,"_51":560,"_53":562},{"_542":5381,"_49":556,"_51":556,"_53":558},{"_542":5380,"_49":552,"_51":552,"_53":554},{"_542":5379,"_49":548,"_51":548,"_53":550},{"_49":5378,"_51":5378,"_53":541},5000,274930,40250,8334,498,2624,978,420,137.2,50.7,{"_2350":142,"_2351":142},[5390],{"_91":5391,"_94":113},{"_176":5392,"_178":5393,"_14":5394,"_508":5395,"_510":5396,"_182":5397,"_464":5398},{"_139":936},{"_139":189},"rgba(0,0,0,1)",{"_518":5399,"_520":5400,"_20":5401},{"_139":517},{"_190":190,"_139":515},{"_139":515},{"_139":5412},{"_139":5411},{"_181":5367,"_26":5367,"_28":20,"_31":32,"_33":5368,"_525":5368,"_35":5402},{"_37":5403,"_39":5404,"_41":5405,"_43":5406,"_45":5407,"_532":5408,"_534":5409,"_47":5410},{"_542":5385,"_49":572,"_51":572,"_53":574},{"_542":5384,"_49":568,"_51":568,"_53":570},{"_542":5383,"_49":564,"_51":564,"_53":566},{"_542":5382,"_49":560,"_51":560,"_53":562},{"_542":5381,"_49":556,"_51":556,"_53":558},{"_542":5380,"_49":552,"_51":552,"_53":554},{"_542":5379,"_49":548,"_51":548,"_53":550},{"_49":5378,"_51":5378,"_53":541},96.7,47,{"_181":985},[5415,5416,5417],{"_91":5457,"_94":113},{"_91":5420,"_92":5421,"_94":113},{"_91":5418,"_94":113},{"_176":5419,"_395":396},{"_139":407},{},[5422,5423],{"_91":5454,"_94":113},{"_91":5424,"_92