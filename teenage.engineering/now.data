_128":129,"_130":166,"_132":4265},[4268],{"_136":4266,"_94":11,"_139":8},{"_1507":4267,"_148":32,"_141":142},"dj-haydn",{"_128":150,"_150":4269},"catching up with dj haydn",{"_139":964},{"_139":964},{"_176":4273,"_178":4274},{"_139":232},{"_139":396},{"_176":4276},{"_139":209},{"_181":4783},[4279,4280,4281,4282,4283,4284,4285,4286,4287,4288,4289,4290],{"_91":4742,"_92":4743,"_94":113},{"_91":4675,"_92":4676,"_94":113},{"_91":4650,"_92":4651,"_94":113},{"_91":4595,"_92":4596,"_94":113},{"_91":4565,"_92":4566,"_94":113},{"_91":4509,"_92":4510,"_94":113},{"_91":4479,"_92":4480,"_94":113},{"_91":4423,"_92":4424,"_94":113},{"_91":4393,"_92":4394,"_94":113},{"_91":4337,"_92":4338,"_94":113},{"_91":4297,"_92":4298,"_94":113},{"_91":4291,"_92":4292,"_94":113},{},[4293],{"_91":4294,"_94":113},{"_176":4295,"_235":4296,"_395":396},{"_139":209},{"_397":142,"_92":398},{"_181":473},[4299,4300,4301],{"_91":4333,"_94":113},{"_91":4305,"_92":4306,"_94":113},{"_91":4302,"_94":113},{"_176":4303,"_178":4304,"_395":396},{"_139":407},{"_139":189},{"_178":4331,"_181":463,"_464":4332,"_185":232},[4307],{"_91":4308,"_94":119},{"_92":4309},[4310,4311],{"_92":4326,"_128":129,"_130":441},{"_92":4312,"_128":129,"_130":420},[4313,4314,4315,4316,4317,4318],{"_128":150,"_150":4325},{"_128":144},{"_128":144},{"_128":150,"_150":4324},{"_92":4319,"_128":129,"_132":4320},{"_128":150,"_150":3836},[4323],{"_136":4321,"_94":434,"_139":4322},{"_148":142},"https://open.spotify.com/album/4qo2WiFufk5W75f3H8jIK9?si=2B9-s3GcSombJBFi5W_ZXA",{"_128":150,"_150":437},"make sure to listen to their new album 8 am Swim ","this is probably our most refined project so far. we’ve released a lot over the years, but with this album we really slowed down and focused on making something cohesive. it took about a year, which is the longest we’ve ever spent on a project. it leans more into house compared to some of our older stuff, but it still feels very much like our take on that sound. a lot of it came from touring and learning how to hold a dancefloor over time. we also wanted to step back from constantly releasing music and instead build something that feels complete as a full body of work.",[4327,4328,4329],{"_128":150,"_150":4330},{"_128":144},{"_128":144},"what did the process behind 8 am Swim look like?",{"_139":209},{"_190":190,"_139":466},{"_176":4334,"_178":4335,"_464":4336,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[4339,4340,4341,4342],{"_91":4389,"_94":113},{"_91":4364,"_94":113},{"_91":4345,"_92":4346,"_94":113},{"_91":4343,"_94":113},{"_176":4344,"_395":396},{"_139":396},{"_181":503},[4347,4348],{"_91":4360,"_94":113},{"_91":4349,"_92":4350,"_94":113},{"_178":4358,"_464":4359,"_185":232},[4351],{"_91":4352,"_94":119},{"_92":4353},[4354],{"_92":4355,"_128":129,"_130":493,"_134":494},[4356,4357],{"_128":144},{"_128":144},{"_139":209},{"_139":189},{"_176":4361,"_178":4362,"_464":4363,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":4365,"_178":4366,"_508":4367,"_510":4368,"_181":512,"_182":4369,"_464":4370},{"_190":190,"_139":1823},{"_139":209},{"_518":4371,"_20":4372},{"_139":3234},{"_190":191,"_139":2684},{"_190":190,"_139":515},{"_139":2101},{"_181":4373,"_26":4373,"_28":20,"_31":32,"_33":4374,"_525":4374,"_35":4375},"6a29b9c05becbf7800bfbe4c","6a29b9c0241ec57800e877a5",{"_37":4376,"_39":4377,"_41":4378,"_43":4379,"_45":4380,"_532":4381,"_47":4382},{"_542":4388,"_49":572,"_51":572,"_53":574},{"_542":4387,"_49":568,"_51":568,"_53":570},{"_542":4386,"_49":564,"_51":564,"_53":566},{"_542":4385,"_49":560,"_51":560,"_53":562},{"_542":4384,"_49":556,"_51":556,"_53":558},{"_542":4383,"_49":552,"_51":552,"_53":554},{"_49":552,"_51":552,"_53":541},108604,35118,1562,9982,3486,1346,{"_176":4390,"_178":4391,"_464":4392,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[4395,4396,4397],{"_91":4419,"_94":113},{"_91":4401,"_92":4402,"_94":113},{"_91":4398,"_94":113},{"_176":4399,"_178":4400,"_395":396},{"_139":407},{"_139":189},{"_178":4417,"_181":463,"_464":4418,"_185":232},[4403],{"_91":4404,"_94":119},{"_92":4405},[4406,4407],{"_92":4414,"_128":129,"_130":441},{"_92":4408,"_128":129,"_130":420},[4409,4410,4411,4412],{"_128":144},{"_128":150,"_150":4413},{"_128":144},{"_128":144},"a lot of it comes from our lifestyle, traveling, playing shows, experiencing different places together. touring has been a huge influence on how we think about music, especially seeing how different crowds react. musically, we’ve been into a lot of older house, early 2000s tech house, uk sounds, and also a lot of global stuff. latin rhythms, different club styles, just pulling inspiration from everywhere",[4415],{"_128":150,"_150":4416},"who or what are your current inspirations?",{"_139":209},{"_190":190,"_139":466},{"_176":4420,"_178":4421,"_464":4422,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[4425,4426,4427,4428],{"_91":4475,"_94":113},{"_91":4450,"_94":113},{"_91":4431,"_92":4432,"_94":113},{"_91":4429,"_94":113},{"_176":4430,"_395":396},{"_139":396},{"_181":503},[4433,4434],{"_91":4446,"_94":113},{"_91":4435,"_92":4436,"_94":113},{"_178":4444,"_464":4445,"_185":232},[4437],{"_91":4438,"_94":119},{"_92":4439},[4440],{"_92":4441,"_128":129,"_130":493,"_134":494},[4442,4443],{"_128":144},{"_128":144},{"_139":209},{"_139":189},{"_176":4447,"_178":4448,"_464":4449,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":4451,"_178":4452,"_508":4453,"_510":4454,"_181":512,"_182":4455,"_464":4456},{"_190":190,"_139":1823},{"_139":209},{"_518":4457,"_20":4458},{"_139":3234},{"_190":191,"_139":2684},{"_190":190,"_139":515},{"_139":2101},{"_181":4459,"_26":4459,"_28":20,"_31":32,"_33":4460,"_525":4460,"_35":4461},"6a29b9c0bcde187800bc9f89","6a29b9c0e3415178003b5dc0",{"_37":4462,"_39":4463,"_41":4464,"_43":4465,"_45":4466,"_532":4467,"_47":4468},{"_542":4474,"_49":572,"_51":572,"_53":574},{"_542":4473,"_49":568,"_51":568,"_53":570},{"_542":4472,"_49":564,"_51":564,"_53":566},{"_542":4471,"_49":560,"_51":560,"_53":562},{"_542":4470,"_49":556,"_51":556,"_53":558},{"_542":4469,"_49":552,"_51":552,"_53":554},{"_49":552,"_51":552,"_53":541},138546,45796,3110,16438,6688,2680,{"_176":4476,"_178":4477,"_464":4478,"_471":142},{"_139":396},{"_139":232},{"_139":81},{"_181":473},[4481,4482,4483],{"_91":4505,"_94":113},{"_91":4487,"_92":4488,"_94":113},{"_91":4484,"_94":113},{"_176":4485,"_178":4486,"_395":396},{"_139":407},{"_139":189},{"_178":4503,"_181":463,"_464":4504,"_185":232},[4489],{"_91":4490,"_94":119},{"_92":4491},[4492,4493],{"_92":4500,"_128":129,"_130":441},{"_92":4494,"_128":129,"_130":420},[4495,4496,4497,4498],{"_128":144},{"_128":150,"_150":4499},{"_128":144},{"_128":144},"honestly, it depends on what works in the moment. we’re not really tied to one or the other, we use both hardware and the computer, whatever helps us get ideas out the fastest. using hardware is fun because it kind of breaks you out of routine. if you’re always on the computer, things can start to feel a bit stale. switching workflows keeps it fresh. sometimes we start ideas on hardware, sometimes on the laptop, sometimes even on the phone. it really just depends on the project.",[4501],{"_128":150,"_150":4502},"do you prefer to work with hardware or digitally?",{"_139":209},{"_190":190,"_139":466},{"_176":4506,"_178":4507,"_464":4508,"_471":142},{"_139":396},{"_139":232},{"_190":190,"_139":472},{"_181":20},[4511,4512,4513,4514],{"_91":4561,"_94":113},{"_91":4536,"_94":113},{"_91":4517,"_92":4518,"_94":113},{"_91":4515,"_94":113},{"_176":4516,"_395":396},{"_139":396},{"_181":503},[4519,4520],{"_91":4532,"_94":113},{"_91":4521,"_92":4522,"_94":113},{"_178":4530,"_464":4531,"_185":232},[4523],{"_91":4524,"_94":119},{"_92":4525},[4526],{"_92":4527,"_128":129,"_130":493,"_134":494},[4528,4529],{"_128":144},{"_128":144},{"_139":209},{"_139":189},{"_176":4533,"_178":4534,"_464":4535,"_471":142},{"_139":85},{"_139":232},{"_139":81},{"_176":4537,"_178":4538,"_508":4539,"_510":4540,"_1