1949x1929-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.0103680663556247,"height":1929,"width":1949},"hasAlpha":true,"isOpaque":false}}},"paragraph":[{"_key":"180f38e8d549","_type":"block","children":[{"_key":"1221d61ce3de","_type":"span","marks":[],"text":"The Lattice SDK™ allows developers to quickly build decentralized applications, data services, and hardware integrations into Lattice."}],"markDefs":[],"style":"h6"},{"_key":"82d04967c111","_type":"block","children":[{"_key":"9454487c6935","_type":"span","marks":[],"text":"Lattice SDK is comprised of developer documentation, API references, sample applications, and more to empower developers to rapidly build and reliably deploy meaningful capabilities to even the most austere, contested, and distant operations at the tactical edge."}],"markDefs":[],"style":"normal"},{"_key":"3721132136fa","_type":"block","children":[{"_key":"fc63c5902291","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"8f4f7f2c5b0b","_type":"externalLinkButton","href":"https://dashboard.developer.anduril.com/","linkText":"Join the Lattice Developer Experience"},{"_key":"911b0d292569","_type":"block","children":[{"_key":"17e971e32a74","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"6d1a59aeeb62","_type":"externalLinkButton","href":"http://developer.anduril.com/","linkText":"Explore Lattice Docs"},{"_key":"b507e59b9474","_type":"block","children":[{"_key":"50d99ae85f9b","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"dcf33894022f","_type":"block","children":[{"_key":"3f2404363fa7","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"shortTitle":"Build with Lattice","type":"image"},{"_key":"c3e064c363b6","_type":"latticeFeaturesSlices","backgroundColor":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"items":[{"_key":"ea6e20b574a9","description":"Lattice’s open data models allow any developer to create, enrich, and reference entity data, craft and interpret C2 tasking messages, and integrate C2 applications, robots, and tactical data link assets.","image":{"_type":"imageWithMeta","alt":"Icon representing Lattice SDK open data models for creating, enriching, and referencing entity data and C2 tasking messages","asset":{"_id":"image-defb4cda38811c68d1fd8bb2b9cf10aee12c9b14-234x145-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6137931034482758,"height":145,"width":234},"hasAlpha":true,"isOpaque":false}}},"title":"Open Data Models","type":"image"},{"_key":"d847bbff6a3c776d656ca9ef64a5da69","description":"The Lattice SDK exposes both gRPC and REST APIs in several language-specific bindings including Java, Javascript, Python, Go and our OpenAPI definition.","image":{"_type":"imageWithMeta","alt":"Icon representing Lattice SDK industry-standard gRPC and REST API interfaces in Java, JavaScript, Python, Go, and OpenAPI","asset":{"_id":"image-defb4cda38811c68d1fd8bb2b9cf10aee12c9b14-234x145-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6137931034482758,"height":145,"width":234},"hasAlpha":true,"isOpaque":false}}},"title":"Industry Standard     Interfaces","type":"image"},{"_key":"b31a2857a4b84b24c663019aac6a9f5e","description":"API access is authenticated by industry-standard authentication and authorization. Distribution of data generated via the Lattice SDK is secured.","image":{"_type":"imageWithMeta","alt":"Icon representing Lattice SDK first-class security with industry-standard authentication and authorization for data distribution","asset":{"_id":"image-defb4cda38811c68d1fd8bb2b9cf10aee12c9b14-234x145-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6137931034482758,"height":145,"width":234},"hasAlpha":true,"isOpaque":false}}},"title":"First-class Security","type":"image"},{"_key":"8f4bca50a65c679fe45bdcc78dfe4b1e","description":"Start developing applications and integrations in a Lattice sandbox environment, supported by Anduril experts by joining the Lattice Developer Experience.","image":{"_type":"imageWithMeta","alt":"Icon representing Lattice SDK developer experience with sandbox environments and Anduril expert support","asset":{"_id":"image-defb4cda38811c68d1fd8bb2b9cf10aee12c9b14-234x145-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6137931034482758,"height":145,"width":234},"hasAlpha":true,"isOpaque":false}}},"title":"Developer Experience","type":"image"}],"showHorizontalRule":false,"title":"Features"},{"_key":"0acb632f65c602b2c65dd2d32ebcefae","_type":"spacerSlice","backgroundColor":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"horizontalRule":false,"spacerHeight":"xxl"},{"_key":"33435baa0f82","_type":"textContentSlice","backgroundColor":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"text":"BUILD WITH</br>LATTICE"},{"_key":"372b125ac5b0cea135cf6f4bdd36dd2f","_type":"spacerSlice","backgroundColor":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"horizontalRule":false,"spacerHeight":"xl"},{"_key":"997abdc42db5","_type":"latticeMissionSlice","backgroundColor":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"blocks":[{"_key":"833943d2d325","_type":"latticeMissionSliceBlock","description":[{"_key":"9a603f51188b","_type":"block","children":[{"_key":"06b00c682354","_type":"span","marks":[],"text":"Tasks are the core open data model which communicate requests to manned or unmanned agents to perform purposeful activities, such as moving to a given location, orienting sensing towards a location of interest, or taking more active actions on other entities. This example performs basic tasking and task status management for a notional asset."}],"markDefs":[],"style":"normal"},{"_key":"68b00f33830a","_type":"block","children":[{"_key":"c334129f4448","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"6bb3e94ed96f","_type":"externalLinkButton","href":"https://github.com/anduril/sample-app-auto-reconnaissance","linkText":"Open in GitHub"}],"headline":"Task An Asset"},{"_key":"0a990bd26b77","_type":"latticeMissionSliceBlock","description":[{"_key":"6d72c99d1533","_type":"block","children":[{"_key":"670a6760b9ed","_type":"span","marks":[],"text":"In Lattice, an object is a data model that lets you store and access files across your environment. The Object API is a content-delivery network service that provides resilient data storage at the edge. Use objects together with entities to implement use-cases like track thumbnails, and vessel manifests."}],"markDefs":[],"style":"normal"},{"_key":"92470dc6af36","_type":"block","children":[{"_key":"7a25164c3d7d","_type":"span","marks":[],"text":"This app demonstrates a entity thumbnail use-case implemented with the Lattice SDK. The sample app is a command-line interface tool that lets you upload images to Lattice, and link them with an entity. The Lattice UI shows this linked image as a thumbnail of the entity:"}],"markDefs":[],"style":"normal"},{"_key":"33ae813c2c23","_type":"externalLinkButton","href":"https://github.com/anduril/sample-app-thumbnail","linkText":"Open in GitHub"}],"headline":"Entity Thumbnail"}],"title":"Sample Applications"},{"_key":"63d82edeb37f","_type":"twoColumnRichText","backgroundColor":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"column1":[{"_key":"74e22469cb39","_type":"richTextImage","image":{"_type":"imageWithMeta","alt":"Lattice SDK code screenshot showing a sample application for autonomous reconnaissance task management","asset":{"_id":"image-8a559cb75bd7d95409ab79670f7ed034fd9bcfa5-1462x855-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7099415204678363,"height":855,"width":1462},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"}],"column2":[{"_key":"fb71996b477f","_type":"richTextImage","image":{"_type":"imageWithMeta","alt":"Lattice SDK code screenshot showing a sample application for entity thumbnail management using the Object API","asset":{"_id":"image-846a689b477582020aec7d6437604e70b7c6bb25-2396x1370-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.748905109489051,"height":1370,"width":2396},"hasAlpha":true,"isOpaque":true}}},"imageWidth":"100","style":"center"}],"columnRatio":"ratio-6-6"},{"_key":"d57c18e91669","_type":"modalFormSlice","backgroundColor":{"_createdAt":"2025-03-28T19:57:45Z","_id":"312278d0-9291-4102-932f-2fbe38d107f5","_rev":"x8r7rwnZNJLuzU8uziaQjt","_system":{"base":{"id":"312278d0-9291-4102-932f-2fbe38d107f5","rev":"3h6Aq9HwJKloB0447GtDIQ"}},"_type":"color","_updatedAt":"2025-06-18T01:03:01Z","contrastColor":"#FFFFFF","hex":"#505544","metadata":null,"name":"Green"},"col1":"Join","col2":"Lattice Developer Experience","col3Cta":[{"_key":"bf23abc5e0b0","_type":"externalLink","href":"https://dashboard.developer.anduril.com/","text":"Join the Lattice Developer Experience"}],"col3ExternaLink":{"_type":"externalLink","href":"http://developer.anduril.com/","text":"Explore Lattice Docs"},"col3Text":"Request to join the Lattice Developer Experience in order to get hands-on with Lattice and to take your first steps developing applications and integrations in a Lattice sandbox environment, supported by Anduril experts.","title":"Getting Started Building with Lattice"},{"_key":"dfdc1e1eedfb","_type":"spacerSlice","backgroundColor":{"_createdAt":"2025-03-28T19:47:50Z","_id":"0970ba10-788c-4613-b319-39009fd75a2a","_rev":"UXH5eRH3LWIQEsoDKxb1Mv","_system":{"base":{"id":"0970ba10-788c-4613-b319-39009fd75a2a","rev":"g3LktQjILKhofqwxYxP0ke"}},"_type":"color","_updatedAt":"2026-06-04T16:31:45Z","contrastColor":"#FFFFFF","hex":"#010101","metadata":null,"name":"Black"},"horizontalRule":false,"spacerHeight":"xxl"}],"slug":{"_type":"slug","current":"lattice-sdk"},"title":"Lattice SDK","path":"lattice/lattice-sdk"}