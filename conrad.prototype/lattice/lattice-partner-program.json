{"_createdAt":"2025-04-04T15:26:03Z","_id":"c4cefab7-8ea7-465d-8c34-d1221b0a28c7","_rev":"6uZ0BzZkJlhhvkfsjjvusX","_system":{"base":{"id":"c4cefab7-8ea7-465d-8c34-d1221b0a28c7","rev":"JijlEUT6gWmfJPPV9eH0ER"}},"_type":"page","_updatedAt":"2026-06-10T23:56:57Z","category":"capability","meta":{"description":"The Lattice Partner Program cultivates a software-defined defense ecosystem, enabling partners to create, integrate, and deploy capabilities via Lattice with developer resources, dedicated support, and credibility badging.","title":"Lattice Partner Program"},"parent":{"_id":"9b2a6f22-bf61-4544-a460-6584975cb7d9","parent":null,"slug":{"_type":"slug","current":"lattice"},"title":"Lattice"},"slices":[{"_key":"bfa24b540af4","_type":"navColorSlice","navColorMode":"dark"},{"_key":"f726ebdc99c6","_type":"latticeHeaderSlice","colorPair":{"_createdAt":"2025-04-25T11:07:05Z","_id":"36c12dfd-1d11-4333-97cd-17db9908affb","_rev":"3h6Aq9HwJKloB0447GtDIQ","_type":"colorPair","_updatedAt":"2025-05-08T03:43:38Z","background":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"foreground":{"_createdAt":"2025-03-28T19:47:50Z","_id":"0970ba10-788c-4613-b319-39009fd75a2a","_rev":"UXH5eRH3LWIQEsoDKxb1Mv","_system":{"base":{"id":"0970ba10-788c-4613-b319-39009fd75a2a","rev":"g3LktQjILKhofqwxYxP0ke"}},"_type":"color","_updatedAt":"2026-06-04T16:31:45Z","contrastColor":"#FFFFFF","hex":"#010101","metadata":null,"name":"Black"},"metadata":null,"name":"Light Gray + Black"},"disableBackgroundAnimation":true,"shortTitle":"LATTICE","title":"Partner Program","fallbackVideo":{"_type":"videoWithMeta","asset":{"_id":"file-958cd2866b90cf39bccefe93e53f2929ffab4291-mp4","_type":"sanity.fileAsset","mimeType":"video/mp4","duration":6.7,"width":1920,"height":1080,"optimized":[{"_key":"33a267a587cb","_type":"videoWi