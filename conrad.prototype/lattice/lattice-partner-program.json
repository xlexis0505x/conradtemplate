09b9","_type":"block","children":[{"_key":"ace264a2bd68","_type":"span","marks":[],"text":"Software-defined \nDEFENSE ECOSYSTEM"}],"markDefs":[],"style":"detail"}],"column2":[{"_key":"011f24f78fef","_type":"block","children":[{"_key":"10bbe9db1bd1","_type":"span","marks":[],"text":"The Lattice Partner Program™ cultivates a defense ecosystem built for the tactical edge by enabling partners to create, integrate and deploy meaningful capabilities via Lattice."}],"markDefs":[],"style":"normal"},{"_key":"34abc5373ef9","_type":"block","children":[{"_key":"d7f30222bf19","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"8ee0fdbc2886","_type":"block","children":[{"_key":"8382721209e1","_type":"span","marks":[],"text":"Lattice Partner Program provides credibility and differentiation of partner capabilities to customer and the market by highlighting proven integrations with third-party systems."}],"markDefs":[],"style":"normal"}],"columnRatio":"ratio-8-4"},{"_key":"08f56c51ef9c","_type":"latticeFeaturesSlices","backgroundColor":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"items":[{"_key":"ef2ac95dc9e3","description":"Partners receive access to developer resources, such as documentation, Lattice sandbox environments, representative data, testing and validation, and reference applications to build, integrate, and deploy capabilities for the tactical edge.","image":{"_type":"imageWithMeta","alt":"Icon representing Lattice Partner Program developer resources including documentation, sandbox environments, and reference applications","asset":{"_id":"image-defb4cda38811c68d1fd8bb2b9cf10aee12c9b14-234x145-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6137931034482758,"height":145,"width":234},"hasAlpha":true,"isOpaque":false}}},"title":"Developer Resources","type":"image"},{"_key":"ec29d4e57904","description":"Partners receive access to dedicated Anduril support teams to assist with troubleshooting and support third-party application development.","image":{"_type":"imageWithMeta","alt":"Icon representing dedicated Anduril support teams for Lattice Partner Program members","asset":{"_id":"image-defb4cda38811c68d1fd8bb2b9cf10aee12c9b14-234x145-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6137931034482758,"height":145,"width":234},"hasAlpha":true,"isOpaque":false}}},"title":"Dedicated Support","type":"image"},{"_key":"dce066cd70d5","description":"Lattice Partner Program helps provide credibility to customer and the market by highlighting proven integrations with Lattice","image":{"_type":"imageWithMeta","alt":"Icon representing Lattice Partner Program credibility badging for proven integrations with the Lattice platform","asset":{"_id":"image-a21a1aee38143017eb74de7b1354493535e144a0-233x143-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6293706293706294,"height":143,"width":233},"hasAlpha":true,"isOpaque":false}}},"title":"Credibility","type":"image"},{"_key":"83d4cfcf8086","description":"Partners receive Lattice Partner Badging for use on marketing collateral, as well as opportunities for joint-marketing efforts.","image":{"_type":"imageWithMeta","alt":"Icon representing Lattice Partner Program marketing support including partner badging and joint marketing opportunities","asset":{"_id":"image-defb4cda38811c68d1fd8bb2b9cf10aee12c9b14-234x145-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6137931034482758,"height":145,"width":234},"hasAlpha":true,"isOpaque":false}}},"title":"Marketing","type":"image"}],"showHorizontalRule":false,"title":"Lattice Partner Benefits"},{"_key":"c71aa0df038b58ed665c12a61aa21c4a","_type":"spacerSlice","backgroundColor":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"horizontalRule":false,"spacerHeight":"xxl"},{"_key":"7cfb0eeeedef","_type":"textContentSlice","backgroundColor":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"text":"Lattice</br>Defense</br>Ecosystem"},{"_key":"2f8d45ba80fe06f62fcd4a57b74e6525","_type":"spacerSlice","backgroundColor":{"_createdAt":"2025-03-28T19:58:31Z","_id":"42e423b4-7b69-454a-b56f-20c07094ddd7","_rev":"Rmu8w9WmfRS5MFvcURmUwe","_type":"color","_updatedAt":"2025-06-18T01:02:14Z","contrastColor":"#010101","hex":"#D8D8D4","metadata":null,"name":"Light Gray"},"horizontalRule":false,"spacerHeight":"xxl"},{"_key":"a03caaac0059","_type":"accordionSlice","backgroundColor":{"_createdAt":"2025-03-28T19:47:50Z","_id":"0970ba10-788c-4613-b319-39009fd75a2a","_rev":"UXH5eRH3LWIQEsoDKxb1Mv","_system":{"base":{"id":"0970ba10-788c-4613-b319-39009fd75a2a","rev":"g3LktQjILKhofqwxYxP0ke"}},"_type":"color","_updatedAt":"2026-06-04T16:31:45Z","contrastColor":"#FFFFFF","hex":"#010101","metadata":null,"name":"Black"},"items":[{"_key":"98b75e981205","description":[{"_key":"22d129a84a24","_type":"block","children":[{"_key":"b9a6e0e310b8","_type":"span","marks":[],"text":"“The U.S. government's need for rapidly deployable satellite platforms has never been more clear as adversaries threaten the bespoke and exquisite assets on orbit today. Apex offers a productized approach that enables the military and intelligence community to rapidly launch proliferated, attritable systems into orbit. Apex is proud to offer Lattice as a C2 option for our customers.”"}],"markDefs":[],"style":"normal"},{"_key":"fca8da41341d","_type":"block","children":[{"_key":"36d0a3b3ff38","_type":"span","marks":[],"text":"— Ian Cinnamon, CEO and Co-Founder, Apex Space"}],"markDefs":[],"style":"normal"}],"imageMode":"logos","images":[{"_key":"e62cf50fcc91","_type":"imageWithMeta","alt":"Apex Space logo","asset":{"_id":"image-a8cc5f649ade90c5d2b974b1ed736888d3053c91-284x89-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":3.191011235955056,"height":89,"width":284},"hasAlpha":true,"isOpaque":true}}}],"title":"Apex"},{"_key":"4aec494075bc","description":[{"_key":"7819024ff6af","_type":"block","children":[{"_key":"f149f523924e","_type":"span","marks":[],"text":"\"Integration of Forterra’s AutoDrive equipped self driving vehicles into Anduril’s Lattice platform is driving optimization of human-machine teaming, while reducing cognitive loads across the ground domain.\""}],"markDefs":[],"style":"normal"},{"_key":"514646b48bac","_type":"block","children":[{"_key":"86d343263e4e","_type":"span","marks":[],"text":"— Patrick Acox, Vice President - Defense Business Development, Forterra"}],"markDefs":[],"style":"normal"}],"imageMode":"logos","images":[{"_key":"01e09c82ae77","_type":"imageWithMeta","alt":"Forterra logo","asset":{"_id":"image-88e3e34421e34c3635d8479774896e77132d386a-2893x1872-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.545405982905983,"height":1872,"width":2893},"hasAlpha":true,"isOpaque":false}}}],"title":"Forterra"},{"_key":"de652ce526bd","description":[{"_key":"e1580dfba5cf","_type":"block","children":[{"_key":"f9d28f5dda42","_type":"span","marks":[],"text":"\"Partnering with Anduril enhances the tactical capabilities of Mira; onboarding into the Lattice system creates new opportunities for mission operations, including allowing a single operator to control, task, and maneuver multiple spacecraft simultaneously. Together, Mira and Lattice can provide new capabilities for Space Domain Awareness and Rendezvous and Proximity Operations.\""}],"markDefs":[],"style":"normal"},{"_key":"5298bf2a00c8","_type":"block","children":[{"_key":"41f7c77a39d8","_type":"span","marks":[],"text":"— Eric Romo, Impulse Space President and COO"}],"markDefs":[],"style":"normal"}],"imageMode":"logos","images":[{"_key":"80507170df87","_type":"imageWithMeta","alt":"Impulse Space logo","asset":{"_id":"image-89495c132712afc9d9b5f2e79ec85806e4550a57-1498x708-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":2.115819209039548,"height":708,"width":1498},"hasAlpha":true,"isOpaque":false}}}],"title":"Impulse Space"},{"_key":"ee9b586ae08c","description":[{"_key":"2392ec35991c","_type":"block","children":[{"_key":"4f406c6924b4","_type":"span","marks":[],"text":"\"Oracle is excited to partner with Anduril, and the Lattice Partner Program further accelerates innovation of autonomous effects at the tactical edge. Oracle Cloud Infrastructure (OCI) from core to edge brings key, hyperscale capabilities to the Anduril partner ecosystem, enabling Lattice-based solutions to deploy and operate in disrupted, disconnected, intermittent and low-bandwidth (DDIL) environments.\""}],"markDefs":[],"style":"normal"},{"_key":"6a9098962987","_type":"block","children":[{"_key":"d90e25b72319","_type":"span","marks":[],"text":"— Kim Lynch, EVP, Oracle Government Defense and Intelligence"}],"markDefs":[],"style":"normal"}],"imageMode":"logos","images":[{"_key":"d04ea8b78d5f","_type":"imageWithMeta","alt":"Oracle logo","asset":{"_id":"image-9472ff9aa664b95ababb9aba15d6cfa118589b07-2000x800-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":2.5,"height":800,"width":2000},"hasAlpha":true,"isOpaque":false}}}],"title":"Oracle"},{"_key":"69385a90a99c","description":[{"_key":"a11d7b806cca","_type":"block","children":[{"_key":"c653caa19f7c","_type":"span","marks":[],"text":"\"Our Autonomous Surface Vessels (ASVs) are designed to be highly interoperable, allowing them to easily integrate with a variety of sensors, payloads, and proven software platforms like Lattice. By combining Saronic's cutting-edge ASVs with Anduril's advanced command and control (C2) technology, we are enhancing real-time situational awareness, decision-making, and mission execution for maritime and naval forces\""}],"markDefs":[],"style":"normal"},{"_key":"ce159ad0addf","_type":"block","children":[{"_key":"d2ef7a6353ab","_type":"span","marks":[],"text":"— Dino Mavrookas, Co-founder & CEO, Saronic Technologies"}],"markDefs":[],"style":"normal"}],"imageMode":"logos","images":[{"_key":"274b58cd6f4d","_type":"imageWithMeta","alt":"Saronic Technologies logo","asset":{"_id":"image-c97be09ce23767bbd2f7313ecb06f8269948656e-2000x800-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":2.5,"height":800,"width":2000},"hasAlpha":true,"isOpaque":false}}}],"title":"Saronic"},{"_key":"0571738f8611","description":[{"_key":"16eea84b056b","_type":"block","children":[{"_key":"cbc9cbea354a","_type":"span","marks":[],"text":"\"Combining Scale's Donovan and Anduril's Lattice creates a groundbreaking end-to-end solution that delivers a decision advantage through software and AI-enabled joint staff planning. Donovan is powered by Large Language Models that are fine-tuned to excel at defense tasks. Lattice adds orchestration, planning and simulation capabilities, extending Donovan’s AI capabilities to enable machine-speed command and control at the tactical, operational and strategic levels.\""}],"markDefs":[],"style":"normal"},{"_key":"970981101fc7","_type":"block","children":[{"_key":"456729c70131","_type":"span","marks":[],"text":"— Shaliya Dehipawala, Director of Public Sector Deployment Strategy, Scale AI"}],"markDefs":[],"style":"normal"}],"imageMode":"logos","images":[{"_key":"33d166b6ac70","_type":"imageWithMeta","alt":"Scale AI logo","asset":{"_id":"image-d6a68b38ab609649dd71ba0af0b52aec8f6da1ca-2000x800-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":2.5,"height":800,"width":2000},"hasAlpha":true,"isOpaque":false}}}],"title":"Scale"},{"_key":"ac90224a084c","description":[{"_key":"da5d1543b9e6","_type":"block","children":[{"_key":"dbaa999345a8","_type":"span","marks":[],"text":"\"Spire Global is excited to bring our resilient space-based data solutions to the forefront of innovation. By integrating our capabilities into the Lattice ecosystem, we empower partners with critical insights and enhanced situational awareness, even in the most challenging environments.\""}],"markDefs":[],"style":"normal"},{"_key":"19adbf55f914","_type":"block","children":[{"_key":"46d727db9c3d","_type":"span","marks":[],"text":"— Iain Goodridge, Senior Director of Radio Frequency Geolocation (RFGL) Products, Spire Global"}],"markDefs":[],"style":"normal"}],"imageMode":"logos","images":[{"_key":"f162bb0357a8","_type":"imageWithMeta","alt":"Spire Global logo","asset":{"_id":"image-8c1b674fc5f0afda15569474b710189f6d3d9b1b-2000x800-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":2.5,"height":800,"width":2000},"hasAlpha":true,"isOpaque":false}}}],"title":"Spire"},{"_key":"46d7a78dabb0","description":[{"_key":"2ffa795a2d44","_type":"block","children":[{"_key":"683a62019a7e","_type":"span","marks":[],"text":"\"The old aphorism is that amateurs talk strategy and professionals talk logistics. Tomorrow's battlefield is more data-centric than ever, but the logistics of moving that data are exponentially more challenging and highly dynamic. Lattice abstracts complexity away, enabling Striveworks to deliver the right model and the right inference at the right time to our users.\""}],"markDefs":[],"style":"normal"},{"_key":"3477eb1952e9","_type":"block","children":[{"_key":"472bfaa7fc6a","_type":"span","marks":[],"text":"— Jim Rebesco, CEO Striveworks"}],"markDefs":[],"style":"normal"}],"imageMode":"logos","images":[{"_key":"e5192122a2a7","_type":"imageWithMeta","alt":"Striveworks logo","asset":{"_id":"image-ae7240ff1ff077349758384bfbd4367cc94a0d01-1000x132-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":7.575757575757576,"height":132,"width":1000},"hasAlpha":true,"isOpaque":false}}}],"title":"Striveworks"},{"_key":"bc538bb857b3","description":[{"_key":"ec7351953189","_type":"block","children":[{"_key":"ce0884bb0b1e","_type":"span","marks":[],"text":"\"Textron Systems has teamed with Anduril on two DoD exercises demonstrating multi-aircraft and sensor control leveraging their Lattice software suite. In both cases the integration of the Lattice mission software on our Aerosonde UAS was simple and effective.\""}],"markDefs":[],"style":"normal"},{"_key":"aee6c6cdd4ba","_type":"block","children":[{"_key":"efd8d3b7134b","_type":"span","marks":[],"text":"— Jim Ryan, Senior Director GMSS Air Domain Textron Systems"}],"markDefs":[],"style":"normal"}],"imageMode":"logos","images":[{"_key":"7d2ec17f8867","_type":"imageWithMeta","alt":"Textron Systems logo","asset":{"_id":"image-a968e7dc1323a25b5989041726c08a579e8762ec-2000x800-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":2.5,"height":800,"width":2000},"hasAlpha":true,"isOpaque":false}}}],"title":"Textron Systems"},{"_key":"fc59ade90f23","description":[{"_key":"bd2f1980a7c9","_type":"block","children":[{"_key":"f72a89ca45ce","_type":"span","marks":[],"text":"“We are excited to partner with Anduril to provide our Builders best-in-class software resources through the Lattice Partnership Program because it will help accelerate product delivery to our end-users. Valinor combines a supercharged go-to-market engine with a unique corporate model to rapidly capitalize and deploy technology for the U.S. Government and our allies. We are proud to be a strategic partner to Anduril in addition to the exciting new Lattice Partner Program.”"}],"markDefs":[],"style":"normal"},{"_key":"c199d86d1267","_type":"block","children":[{"_key":"756b28b302a6","_type":"span","marks":[],"text":"— Julie Bush, Co-Founder & CEO, Valinor Enterprises"}],"markDefs":[],"style":"normal"}],"imageMode":"logos","images":[{"_key":"2be61d8bd6f3","_type":"imageWithMeta","alt":"Valinor Enterprises logo","asset":{"_id":"image-9f9a756d8fd86d15aac0b36ba2d2479342819e2a-1500x286-png","_type":"sanity.imageAsset","mimeType":"image/png","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":5.244755244755245,"height":286,"width":1500},"hasAlpha":true,"isOpaque":false}}}],"title":"Valinor"}],"title":"Lattice Partners"},{"_key":"5a844c98fc42","_type":"modalFormSlice","backgroundColor":{"_createdAt":"2025-03-28T19:59:38Z","_id":"13e1dd3f-59e1-4bca-aab8-7053c97103e6","_rev":"x8r7rwnZNJLuzU8uziaPMO","_system":{"base":{"id":"13e1dd3f-59e1-4bca-aab8-7053c97103e6","rev":"3h6Aq9HwJKloB0447GtDIQ"}},"_type":"color","_updatedAt":"2025-06-18T01:02:46Z","contrastColor":"#FFFFFF","hex":"#565654","metadata":null,"name":"Graphite"},"col1":"Join","col2":"Lattice Developer Experience","col3Cta":[{"_key":"3e21a9cf96f1","_type":"externalLink","href":"https://dashboard.developer.anduril.com/","text":"Join the Lattice Developer Experience"}],"col3ExternaLink":{"_type":"externalLink","href":"http://developer.anduril.com/","text":"Explore Lattice Docs"},"col3Text":"Request to join the Lattice Developer Experience in order to get hands-on with Lattice Mesh services and to take your first steps towards developing applications and integrations.","title":"Get Started Building with Lattice"},{"_key":"34d4a94c3651","_type":"spacerSlice","backgroundColor":{"_createdAt":"2025-03-28T19:47:50Z","_id":"0970ba10-788c-4613-b319-39009fd75a2a","_rev":"UXH5eRH3LWIQEsoDKxb1Mv","_system":{"base":{"id":"0970ba10-788c-4613-b319-39009fd75a2a","rev":"g3LktQjILKhofqwxYxP0ke"}},"_type":"color","_updatedAt":"2026-06-04T16:31:45Z","contrastColor":"#FFFFFF","hex":"#010101","metadata":null,"name":"Black"},"horizontalRule":false,"spacerHeight":"xxl"}],"slug":{"_type":"slug","current":"lattice-partner-program"},"title":"Lattice Partner Program","path":"lattice/lattice-partner-program"}